<mujoco>
  <compiler autolimits="true"/>
  
  <!-- Setting to adjust camera/mouse sensitivity to match the car's scale. 
       Prevents the massive camera jump on mouse scroll since the initial track was huge. -->
  <statistic extent="3.0" center="0 0 0"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
    <mesh name="chasis" scale=".01 .006 .0015"
      vertex=" 9   2   0
              -10  10  10
               9  -2   0
               10  3  -10
               10 -3  -10
              -8   10 -10
              -10 -10  10
              -8  -10 -10
              -5   0   20"/>
  </asset>

  <default>
    <joint damping=".03" actuatorfrcrange="-0.5 0.5"/>
    <default class="wheel">
      <geom type="cylinder" size=".03 .01" rgba=".5 .5 1 1"/>
    </default>
    <default class="decor">
      <site type="box" rgba=".5 1 .5 1"/>
    </default>
  </default>

  <worldbody>
    <!-- Wide grassy background -->
    <geom name="grass" type="plane" pos="15 0 -0.01" size="30 20 .01" rgba="0.15 0.4 0.15 1"/>
    
    <!-- 3-lane asphalt road (based on 15cm car width, 25cm lane width. Total width 75cm -> half-width 0.375) -->
    <geom name="road_asphalt" type="plane" pos="15 0 0" size="20 0.375 .01" rgba="0.2 0.2 0.2 1"/>
    
    <!-- White dashed lane lines (2cm thick, 1.5m dash length, 1.5m gap) -->
    <geom name="dash_-4_L" type="box" pos="-4 -0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_-4_R" type="box" pos="-4  0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_-1_L" type="box" pos="-1 -0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_-1_R" type="box" pos="-1  0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_2_L" type="box" pos="2 -0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_2_R" type="box" pos="2  0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_5_L" type="box" pos="5 -0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_5_R" type="box" pos="5  0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_8_L" type="box" pos="8 -0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_8_R" type="box" pos="8  0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_11_L" type="box" pos="11 -0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_11_R" type="box" pos="11  0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_14_L" type="box" pos="14 -0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_14_R" type="box" pos="14  0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_17_L" type="box" pos="17 -0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_17_R" type="box" pos="17  0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_20_L" type="box" pos="20 -0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_20_R" type="box" pos="20  0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_23_L" type="box" pos="23 -0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_23_R" type="box" pos="23  0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_26_L" type="box" pos="26 -0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_26_R" type="box" pos="26  0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_29_L" type="box" pos="29 -0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_29_R" type="box" pos="29  0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_32_L" type="box" pos="32 -0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_32_R" type="box" pos="32  0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_35_L" type="box" pos="35 -0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="dash_35_R" type="box" pos="35  0.125 0.002" size="0.75 0.01 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    
    <!-- Yellow edge lines (matched to road width) -->
    <geom name="edge_line_L" type="box" pos="15 -0.37 0.002" size="20 0.01 0.001" rgba="1 0.8 0 1" contype="0" conaffinity="0"/>
    <geom name="edge_line_R" type="box" pos="15  0.37 0.002" size="20 0.01 0.001" rgba="1 0.8 0 1" contype="0" conaffinity="0"/>
    
    <!-- Goal line and visual arch at 20.69m (scaled proportionally to the narrowed width) -->
    <site name="goal_site" pos="20.69 0 0.005" size="0.2 0.375 0.005" type="box" rgba="0 1 0 0.8"/>
    <geom name="goal_pole_L" type="cylinder" pos="20.69 -0.375 0.4" size="0.02 0.4" rgba="1 0.2 0.2 1"/>
    <geom name="goal_pole_R" type="cylinder" pos="20.69  0.375 0.4" size="0.02 0.4" rgba="1 0.2 0.2 1"/>
    <geom name="goal_top" type="box" pos="20.69 0 0.82" size="0.02 0.375 0.02" rgba="1 0.2 0.2 1"/>
    
    <!-- Floating "GOAL" text (bright yellow neon sign effect, hovering above the goal arch) -->
    <!-- "G" (Y center: 0.3) -->
    <geom name="G_top" type="box" pos="20.69 0.3 1.025" size="0.005 0.05 0.01" rgba="1 0.9 0 1" contype="0" conaffinity="0"/>
    <geom name="G_bot" type="box" pos="20.69 0.3 0.875" size="0.005 0.05 0.01" rgba="1 0.9 0 1" contype="0" conaffinity="0"/>
    <geom name="G_left" type="box" pos="20.69 0.35 0.95" size="0.005 0.01 0.075" rgba="1 0.9 0 1" contype="0" conaffinity="0"/>
    <geom name="G_right_bot" type="box" pos="20.69 0.25 0.9125" size="0.005 0.01 0.0375" rgba="1 0.9 0 1" contype="0" conaffinity="0"/>
    <geom name="G_mid" type="box" pos="20.69 0.275 0.95" size="0.005 0.025 0.01" rgba="1 0.9 0 1" contype="0" conaffinity="0"/>
    <geom name="G_nub" type="box" pos="20.69 0.25 1.0125" size="0.005 0.01 0.0125" rgba="1 0.9 0 1" contype="0" conaffinity="0"/>

    <!-- "O" (Y center: 0.1) -->
    <geom name="O_top" type="box" pos="20.69 0.1 1.025" size="0.005 0.05 0.01" rgba="1 0.9 0 1" contype="0" conaffinity="0"/>
    <geom name="O_bot" type="box" pos="20.69 0.1 0.875" size="0.005 0.05 0.01" rgba="1 0.9 0 1" contype="0" conaffinity="0"/>
    <geom name="O_left" type="box" pos="20.69 0.15 0.95" size="0.005 0.01 0.075" rgba="1 0.9 0 1" contype="0" conaffinity="0"/>
    <geom name="O_right" type="box" pos="20.69 0.05 0.95" size="0.005 0.01 0.075" rgba="1 0.9 0 1" contype="0" conaffinity="0"/>

    <!-- "A" (Y center: -0.1) -->
    <geom name="A_top" type="box" pos="20.69 -0.1 1.025" size="0.005 0.05 0.01" rgba="1 0.9 0 1" contype="0" conaffinity="0"/>
    <geom name="A_mid" type="box" pos="20.69 -0.1 0.95" size="0.005 0.05 0.01" rgba="1 0.9 0 1" contype="0" conaffinity="0"/>
    <geom name="A_left" type="box" pos="20.69 -0.05 0.95" size="0.005 0.01 0.075" rgba="1 0.9 0 1" contype="0" conaffinity="0"/>
    <geom name="A_right" type="box" pos="20.69 -0.15 0.95" size="0.005 0.01 0.075" rgba="1 0.9 0 1" contype="0" conaffinity="0"/>

    <!-- "L" (Y center: -0.3) -->
    <geom name="L_left" type="box" pos="20.69 -0.25 0.95" size="0.005 0.01 0.075" rgba="1 0.9 0 1" contype="0" conaffinity="0"/>
    <geom name="L_bot" type="box" pos="20.69 -0.3 0.875" size="0.005 0.05 0.01" rgba="1 0.9 0 1" contype="0" conaffinity="0"/>
    <body name="car" pos="0 0 .03">
      <freejoint/>
      <light name="top light" pos="0 0 2" mode="trackcom" diffuse=".4 .4 .4"/>
      <geom name="chasis" type="mesh" mesh="chasis"/>
      <geom name="front wheel" pos=".08 0 -.015" type="sphere" size=".015" condim="1" priority="1"/>
      <light name="front light" pos=".1 0 .02" dir="2 0 -1" diffuse="1 1 1"/>
      <body name="left wheel" pos="-.07 .06 0" zaxis="0 1 0">
        <joint name="left"/>
        <geom class="wheel"/>
        <site class="decor" size=".006 .025 .012"/>
        <site class="decor" size=".025 .006 .012"/>
      </body>
      <body name="right wheel" pos="-.07 -.06 0" zaxis="0 1 0">
        <joint name="right"/>
        <geom class="wheel"/>
        <site class="decor" size=".006 .025 .012"/>
        <site class="decor" size=".025 .006 .012"/>
      </body>
    </body>
  </worldbody>

  <tendon>
    <fixed name="forward">
      <joint joint="left" coef=".5"/>
      <joint joint="right" coef=".5"/>
    </fixed>
    <fixed name="turn">
      <joint joint="left" coef="-.5"/>
      <joint joint="right" coef=".5"/>
    </fixed>
  </tendon>

  <actuator>
    <motor name="forward" tendon="forward" ctrlrange="-1 1"/>
    <motor name="turn" tendon="turn" ctrlrange="-1 1"/>
  </actuator>

  <sensor>
    <jointactuatorfrc name="right" joint="right"/>
    <jointactuatorfrc name="left" joint="left"/>
  </sensor>
</mujoco>
