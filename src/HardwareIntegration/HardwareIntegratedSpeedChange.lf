target Python {keepalive: true}

import SensorInputs from "SensorInputs.lf"

reactor Driver{

    output steer
    output accelerator
    output brake
    output head
    logical action a
    state started = False

    sen = new SensorInputs()

    reaction(startup) {=
        a.schedule(800_000_000)
    =}

    reaction(a) {=
        self.started = True
    =}

    state steer_val = 2
    state accel_val = 0.0
    state brake_val = 0.0
    state head_val = 5

    reaction(sen.eye_msg, sen.head_msg, sen.steer_msg, sen.accel_msg, sen.brake_msg)
    -> accelerator, brake, steer, head {=
        if not self.started:
            return

        if sen.head_msg.is_present:
            self.head_val = sen.head_msg.value

        if sen.steer_msg.is_present:
            self.steer_val = sen.steer_msg.value

        if sen.accel_msg.is_present:
            self.accel_val = sen.accel_msg.value

        if sen.brake_msg.is_present:
            self.brake_val = sen.brake_msg.value

        steer.set(self.steer_val)
        accelerator.set(self.accel_val)
        brake.set(self.brake_val)
        head.set(self.head_val)

        print("---------------------------------------")
        print(f"from driver head: {self.head_val} \n")
        print(f"from driver brake: {self.brake_val} \n")
        print(f"from driver accelerator: {self.accel_val} \n")
        print(f"from driver steer: {self.steer_val} \n")
        print("---------------------------------------")
    =}
}

reactor Car{

    input steer_in
    input accel_in
    input brake_in
    input actuate_in 
    input head_pos_in  

    state acceleration_net
    state velocity_init = 0.0
    state dist_init = 0.0
    state started = False
    logical action a

    output velocity
    output steer
    output head_pos

    reaction(startup) {=
        a.schedule(800_000_000)
    =}

    reaction(a) {=
        self.started = True
    =}

    reaction(accel_in, brake_in, steer_in, actuate_in, head_pos_in)
    -> velocity, steer, head_pos {=
        if not self.started:
            return

        amsg = accel_in.value if accel_in.is_present else 0.0
        bmsg = brake_in.value if brake_in.is_present else 0.0
        amsg = 0.0 if amsg is None else float(amsg)
        bmsg = 0.0 if bmsg is None else float(bmsg)
        act  = actuate_in.value if actuate_in.is_present else None

        smsg = steer_in.value if steer_in.is_present else 2
        hmsg = head_pos_in.value if head_pos_in.is_present else 5

        def acel_cal(p):
            p = max(0.0, min(1.0, p))
            if p<0.1:
                return p
            elif p<0.6:
                return 2.4 * p
            else:
                return 4.0*(p**2)

        def brake_cal(p):
            p = max(0.0, min(1.0, p))
            if p<0.1:
                return p
            elif p<0.6:
                return -(5.4 * p)
            else:
                return -(9.0*(p**2))

        if act == 11:
            self.acceleration_net = -9.0
        else:
            if bmsg > 0.0:
                self.acceleration_net = brake_cal(bmsg)
            elif amsg > 0.0:
                self.acceleration_net = acel_cal(amsg)
            else:
                self.acceleration_net = -0.5

        vel = self.velocity_init + self.acceleration_net * 0.1

        if vel < 0.0:
            vel = 0.0

        d = self.dist_init + vel * 0.1

        print(f"from car Velocity: {vel}", flush=True)
        print(f"from car Distance: {d}", flush=True)

        velocity.set(vel)
        steer.set(smsg)
        head_pos.set(hmsg)

        self.velocity_init = vel
        self.dist_init = d
    =}
}

reactor Environment{

    input v
    state pos_stop_sign = 100.0
    state passed = False
    state started = False
    logical action a

    output displacement

    reaction(startup) {=
        a.schedule(800_000_000)
    =}

    reaction(a) {=
        self.started = True
    =}

    reaction(v) -> displacement {=
        if not self.started:
            return

        vn = float(v.value)
        step = vn * 0.1

        if not self.passed:
            self.pos_stop_sign -= step
            if self.pos_stop_sign <= 0.0:
                self.pos_stop_sign = 0.0
                self.passed = True

            displacement.set(self.pos_stop_sign)
        else:
            displacement.set(0.0)

        print(f"displacement from the environment: {displacement.value}", flush=True)
    =}
}

reactor LLMInference {
    input s
    input v
    input st 
    input h

   
    output control
    output instruction

    state last_dl_tok = ""
    state last_dl_msg = ""
    state is_ready = False

    preamble{=
        import ollama
        import time
        from enum import Enum

        ALLOWED = {"NONE", "WARNING", "ACTUATE"}

        def run_llm_message(self, rd_val, v_val):
            t0 = time.perf_counter()
            try:
                r = ollama.chat(
                    model="llama3:8b",
                    messages=[
                        {"role": "system", "content": "You are an agentic driving coach."},
                        {"role": "user", "content": f"distance_to_stop={rd_val:.2f}m speed={v_val:.2f}m/s"},
                    ],
                    options={"temperature": 0.0, "num_predict": 30},
                )
            except Exception:
                return "NONE", "", 0.0

            ms = (time.perf_counter() - t0) * 1000.0
            raw = (r.get("message", {}).get("content", "") or "").strip()

            tok = "NONE"
            msg = ""

            if raw:
                parts = raw.split("|", 1)
                tok = parts[0].upper().strip()
                if len(parts) == 2:
                    msg = parts[1].strip()

            if tok not in ALLOWED:
                tok = "NONE"
                msg = ""

            return tok, msg, ms

        def fallback_policy(self, rd_val, v_val):
            if rd_val <= 0.0:
                return "NONE", ""
            if rd_val <= 25.0 and v_val > 2.5:
                return "ACTUATE", "Brake now."
            if 50.0 < rd_val <= 60.0 and (v_val > 10.0 or v_val < 8.0):
                return "WARNING", "Adjust speed and prepare to stop."
            if rd_val >= 99.0 and (v_val > 12.0 or v_val < 8.0):
                return "WARNING", "Stop sign ahead."
            return "NONE", ""
    =}

    reaction(startup) {=
        import ollama
        ollama.chat(model="llama3:8b", messages=[{"role": "user", "content": "hi"}])
        self.is_ready = True
       
    =}

    reaction(s, v, st, h) -> control, instruction {=
        if not self.is_ready:
            return

        rd_val = s.value if s.value is not None else 0.0
        v_val  = v.value if v.value is not None else 0.0

        if rd_val <= 0.0:
            control.set("NONE")
            instruction.set("")
            return

        tok, msg, _ = self.run_llm_message(rd_val, v_val)
        control.set(tok)
        instruction.set(msg)
    =}

    deadline(250 msec) {=
        rd_val = s.value if s.value is not None else 0.0
        v_val  = v.value if v.value is not None else 0.0

        tok, msg = self.fallback_policy(rd_val, v_val)

        if tok == self.last_dl_tok and msg == self.last_dl_msg:
            return

        self.last_dl_tok = tok
        self.last_dl_msg = msg

        control.set(tok)
        instruction.set(msg)
    =}
}

reactor Planner {
  input ctrl
  input instr
  input s
  input v
  output act
  output planned_instr

  state last_warn_ns = -1000000000000
  state last_printed = ""

  initial mode monitoring {
    reaction(ctrl, instr, s, v) -> warning, actuate, planned_instr {=
      throttle = 1000000000
      kw  = (ctrl.value or "NONE").strip()
      instruction = (instr.value or "").strip()
      rd  = s.value if s.value is not None else 0.0

      now_ns = lf.time.logical_elapsed()

      if kw == "ACTUATE" and rd > 0.0:
        if instruction and instruction != self.last_printed:
          i = f"[VERBAL] {kw} | {instruction}"
          planned_instr.set(i)
          self.last_printed = instruction
        actuate.set()
        return

      if kw == "WARNING":
        if (now_ns - self.last_warn_ns) >= throttle:
          if instruction and instruction != self.last_printed:
            i = f"[VERBAL] {kw} | {instruction}"
            planned_instr.set(i)
            self.last_printed = instruction
          self.last_warn_ns = now_ns
        warning.set()
        return
    =}
  }

  mode warning {
    reaction(ctrl, instr, s, v) -> monitoring, actuate, planned_instr {=
      throttle = 1000000000
      kw  = (ctrl.value or "NONE").strip()
      instruction = (instr.value or "").strip()
      rd  = s.value if s.value is not None else 0.0

      now_ns = lf.time.logical_elapsed()

      if kw == "ACTUATE" and rd > 0.0:
        if instruction and instruction != self.last_printed:
          i = f"[VERBAL] {kw} | {instruction}"
          planned_instr.set(i)
          self.last_printed = instruction
        actuate.set()
        return

      if kw == "NONE":
        monitoring.set()
        return

      if kw == "WARNING":
        if (now_ns - self.last_warn_ns) >= throttle:
          if instruction and instruction != self.last_printed:
            i = f"[VERBAL] {kw} | {instruction}"
            planned_instr.set(i)
            self.last_printed = instruction
          self.last_warn_ns = now_ns
        return
    =}
  }

  mode actuate {
    reaction(ctrl, s, v) -> act, monitoring, planned_instr {=
      kw = (ctrl.value or "NONE").strip()
      rd = s.value if s.value is not None else 0.0

      if kw != "ACTUATE" or rd <= 0.0:
        monitoring.set()
        return

      i = f"[VERBAL] {kw} | Sent EmergencyBraking"
      act.set(11)
      planned_instr.set(i)

      monitoring.set()
    =}
  }
}

reactor Coach{
    input s
    input v
    input st 
    input h

    output act
    output instr
    output ready

    llm = new LLMInference()
    a = new Planner()
    // logical action wait

    // reaction(startup) {=
    //      wait.schedule(800 msec)
    
    // =}
    s -> llm.s
    v -> llm.v
    st -> llm.st
    h -> llm.h

    llm.control -> a.ctrl
    llm.instruction -> a.instr

    s -> a.s
    v -> a.v

    // llm.ready -> ready

    a.act -> act
    a.planned_instr -> instr
}

federated reactor at 10.218.100.78 {
    
    d = new Driver()
    c = new Car()
    en = new Environment()
    adc = new Coach()

    // reaction(startup) -> start_all {=
    //     start_all.schedule(800 msec)
    // =}

    // start_all -> d.startup
    // start_all -> c.startup
    // start_all -> en.startup

    d.accelerator -> c.accel_in 
    d.brake -> c.brake_in 
    d.steer -> c.steer_in 
    d.head -> c.head_pos_in 

    c.velocity -> en.v
    c.velocity -> adc.v
    c.steer -> adc.st
    c.head_pos -> adc.h

    en.displacement -> adc.s

    adc.act -> c.actuate_in after 200 ms
}