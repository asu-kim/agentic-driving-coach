reactor Car{
    // input start_signal
    // state started = False

    input steer_in
    input accel_in
    input brake_in
    input actuate_in 
    input head_pos_in  
    input eye_pos_in

    state acceleration_net
    state velocity_init = 30
    state dist_init = 0.0
  
    state accel_val = 0.0
    state brake_val = 0.0
    state act_val 

    output velocity
    output steer
    output head_pos
    output eye_pos
    
   preamble{=
    def actuate_logic(self, cmd):
        if cmd == "ACCEL":
            return 0.5, 0.0
        elif cmd == "BRAKE":
            return 0.0, 1.0
        elif cmd == "HOLD":
            return 0.2, 0.0

   =}
    reaction(accel_in, brake_in, eye_pos_in, head_pos_in, steer_in, actuate_in)-> velocity, steer, head_pos, eye_pos {=
        # if not self.started:
        #     return
        # if accel_in.is_present:
        #     self.accel_val = float(accel_in.value)

        # if brake_in.is_present:
        #     self.brake_val = float(brake_in.value)

        print(f"[DEBUG] time={lf.time.logical_elapsed()/1e6}, actuate_present={actuate_in.is_present}", flush=True)
        # if actuate_in.is_present:
        #     print(f"The actuation command: {actuate_in.value} at logical time: {lf.time.logical_elapsed()/1e6} and physical time : {lf.time.physical_elapsed()/1e6}", flush=True)

        ###k = (1/2m)rho* C_d *A

        # Typical values of the drag coefficient for calculation:

        # * \rho = 1.2
        # * C_d = 0.3
        # * A = 2.2
        # * m = 1500
        if actuate_in.is_present:
            print(f"The actuation command: {actuate_in.value} at logical time: {lf.time.logical_elapsed()/1e6} and physical time : {lf.time.physical_elapsed()/1e6}", flush=True)
            amsg, bmsg = self.actuate_logic(actuate_in.value)
        else:
            amsg = accel_in.value
            bmsg = brake_in.value
        MAX_BRAKE = - 9.0
        MAX_ACCEL = 4.0
        A_DRAG_COEF = - 0.0002
        A_FRIC_COEFF = - 0.022
        DT = 0.1
        MAX_VEL = 35.0
        
      
        print(f"The accel pedal position: {amsg:.2f}, The brake pedal: {bmsg:.2f}")
        ## acceleration for throttle is second order polynomial equation

        accel_brake = bmsg * MAX_BRAKE
        accel_throt = (0.6 * amsg + 0.4 * amsg* amsg) * MAX_ACCEL 
        accel_drag = A_DRAG_COEF * self.velocity_init ** 2
        accel_net = accel_brake + accel_throt + accel_drag + A_FRIC_COEFF

        
        vel = self.velocity_init + accel_net * DT
        if vel > MAX_VEL:

            vel = MAX_VEL
        else:
            vel = max(0.0, vel)
            
        dist = self.dist_init + vel * DT


        self.velocity_init = vel
        self.dist_init = dist
        current_dri = lf.time.logical_elapsed()/1e6
        physical_dri = lf.time.physical_elapsed()/1e6
        lag = physical_dri - current_dri

        print("----------------------------------------------------------")
        print(f"[CAR] Logical time: {current_dri:.2f} ", flush=True)
        print(f"[CAR] Physical time: {physical_dri:.2f} ", flush=True)
        print(f"[CAR] LAG: {lag:.2f} ", flush=True)
        print("----------------------------------------------------------")
        print(f"---------------------------------------------------------", flush=True)
        print(f"velocity={vel:.2f} acceleration={accel_net:.2f}", flush=True)
        print(f"Distance travelled={dist:.2f}", flush=True)

        velocity.set(vel)
        steer.set(steer_in.value)
        head_pos.set(head_pos_in.value)
        eye_pos.set(eye_pos_in.value)

    =}   
    

}



reactor Environment{
    // input start_signal
    // state started = False

    input v
    state pos_speed_change = 200.0
    state passed = False
    output displacement
    
    state v_val = 0.0

    // reaction(start_signal) {=
    //     self.started = True
    // =}
    reaction(v) -> displacement{=
        # if not self.started:
        #     return
        if v.is_present:
            self.v_val = float(v.value)
        
        

        step = self.v_val * 0.1

        if not self.passed:
            self.pos_speed_change -= step

            if self.pos_speed_change <= 0.0:
                self.pos_speed_change = 0.0
                self.passed = True

            displacement.set(self.pos_speed_change)
        else:
            displacement.set(0.0)
        current_dri = lf.time.logical_elapsed()/1e6
        physical_dri = lf.time.physical_elapsed()/1e6
        lag = physical_dri - current_dri

        print(f"[ENV CLOCK] displacement={self.pos_speed_change}", flush=True)
        print("----------------------------------------------------------")
        print(f"[ENVIRONMENT] Logical time: {current_dri:.2f} ", flush=True)
        print(f"[ENVIRONMENT] Physical time: {physical_dri:.2f} ", flush=True)
        print(f"[ENVIRONMENT] LAG: {lag:.2f} ", flush=True)
        print("----------------------------------------------------------")
    =}
 
    
    
}



reactor LLMInference {
    input s
    input v
    input st 
    input h
    input e

    // output ready
    output control
    output instruction

    state last_dl_tok = ""
    state last_dl_msg = ""
    // state is_ready = False
    state s_val = 0.0
    state v_val = 0.0
    state st_val = 2
    state h_val = 5

    timer llmclock(4 sec, 400 msec)

    preamble{=
        import ollama
        import time

        def run_llm_message(self, rd_val, v_val):
            import ollama
            import time
            # print(">>> ENTERING LLM CALL", flush=True)
            t0 = time.perf_counter()

            try:
                r = ollama.chat(
                    model="llama3:8b",
                    messages=[
                        {
                            "role": "system",
                            "content": (
                                        """Role: Real-time driving coach

                                            State:
                                            distance = {s} meters
                                            velocity = {v} meter per second
                                            target_speed = 11 meter per second

                                            TOKEN in {NONE, WARNING, ACTUATE}

                                            Inputs:
                                            s = distance (meters)
                                            v = velocity (meter per second)
                                            Target speed = 11 meter per second

                                            Policy:
                                            - If s ≤ 50 and v > 12 → ACTUATE
                                            - Else if s ≤ 100 and v > 20 → WARNING
                                            - Else if s > 150 and v > 30 → WARNING
                                            - Else → NONE

                                            Special:
                                            IF 10.5 ≤ velocity ≤ 11.5 → maintain steady speed

                                            Output Format:
                                            TOKEN|Message

                                            Action:
                                            - Generate correct token and message
                                            - Max 12 words
                                            - About speed control only
                                            - Use "meter per second" (not m/s)
                                            - Include s or v when useful

                                         
                                            Examples:
                                            ACTUATE|Slow down from 18 meter per second
                                            WARNING|At 55 meters reduce speed from 16
                                            ACTUATE|Increase speed slightly from 9 meter per second
                                            NONE"""
                                    )
                        },
                        {
                            "role": "user",
                            "content": f"s={rd_val:.2f}, v={v_val:.2f}"
                        }
                    ],
                    options={"temperature": 0.0, "num_predict": 30},
                )
            except Exception as e:
                print(">>> LLM ERROR:", e, flush=True)
                return "NONE", "", 0.0

            ms = (time.perf_counter() - t0) * 1000.0
            raw = (r.get("message", {}).get("content", "") or "").strip()

            # print(f">>> RAW LLM OUTPUT: {raw}", flush=True)

            return "NONE", raw, ms

        def fallback_policy(self, rd_val, v_val):
            # print(f"[FALLBACK POLICY] evaluating s={rd_val:.2f}, v={v_val:.2f}", flush=True)

            if rd_val <= 0.0:
                return "NONE", ""

            if rd_val <= 25:
                return "ACTUATE", "Brake now."

            if rd_val >= 80:
                return "WARNING", "Speed limit ahead."

            return "NONE", ""

        # def speak(self, msg):
        #     if not msg:
        #         return

        
        #     msg_lower = msg.lower()
        #     if "speed limit achieved" in msg_lower:
        #         msg = "Speed limit achieved. Maintain speed."

        
        #     msg = msg.replace("m/s", "meter per second")
        #     msg = msg.replace("mps", "meter per second")

            
        #     import re
        #     msg = re.sub(r"(\d+)\.(\d+)", r"\1", msg)

        #     print(f"[DEBUG SPEAK] {msg}", flush=True)

        #     try:
        #         if self.speech_proc is not None:
        #             self.speech_proc.kill()
        #     except:
        #         pass

        #     self.speech_proc = subprocess.Popen(
        #         ["espeak", "-s", "120", msg],
        #         stdout=subprocess.DEVNULL,
        #         stderr=subprocess.DEVNULL
        #     )
    =}

    

    reaction(s, v, st, h){=
        # print("\n=== INPUT REACTION TRIGGERED ===", flush=True)
        # print(f"[TIME] logical={lf.time.logical_elapsed()/1e6:.2f}", flush=True)
        # print(f"[TIME] physical={lf.time.physical_elapsed()/1e6:.2f}", flush=True)

        # print(f"[PRESENCE] s={s.is_present}, v={v.is_present}, st={st.is_present}, h={h.is_present}", flush=True)

        if s.is_present:
            self.s_val = s.value
        if v.is_present:
            self.v_val = v.value
        if st.is_present:
            self.st_val = st.value
        if h.is_present:
            self.h_val = h.value

        # print(f"[STATE UPDATE] s_val={self.s_val:.2f}, v_val={self.v_val:.2f}", flush=True)

    =}

    reaction(llmclock) -> control, instruction {=
        # print("\n=== LLM CLOCK TRIGGERED ===", flush=True)

        
        # print(f"[TIME] logical={current_logical:.2f}", flush=True)

        # if not self.is_ready:
        #     # print("[SKIP] LLM not ready", flush=True)
        #     return

        rd_val = self.s_val
        v_val  = self.v_val

        # print(f"[STATE READ] s={rd_val:.2f}, v={v_val:.2f}", flush=True)

        if rd_val <= 0.0:
            rd_val = 0.0
            # control.set("NONE")
            # instruction.set("")
            # return

        # print("[LLM] calling model...", flush=True)
        # add a state variable and eye checked l/r

        tok_raw, msg_raw, ms = self.run_llm_message(rd_val, v_val)
        current_dri = lf.time.logical_elapsed()/1e6
        physical_dri = lf.time.physical_elapsed()/1e6
        lag = physical_dri - current_dri
        print("----------------------------------------------------------")
        print(f"[LLM INFERENCE] Logical time: {current_dri:.2f} ", flush=True)
        print(f"[LLM INFERENCE] Physical time: {physical_dri:.2f} ", flush=True)
        print(f"[LLM INFERENCE] LAG: {lag:.2f} ", flush=True)
        print("----------------------------------------------------------")
        # tok_raw, msg_raw, ms = "NONE|", "WARNING|Speed change ahead", 32
        self.check_deadline()

        raw = (msg_raw or "").strip()

        if "|" in raw:
            tok, msg = raw.split("|", 1)
        else:
            tok = tok_raw or "NONE"
            msg = raw

        tok = tok.strip()
        msg = msg.strip()

        print(f"[LLM RESULT] {tok} | {msg} | {ms:.2f} ms", flush=True)

        control.set(tok)
        instruction.set(msg)

    =} 
    deadline(10 sec) {=
        # print("\n=== DEADLINE TRIGGERED ===", flush=True)

        rd_val = self.s_val
        v_val  = self.v_val

        tok, msg = self.fallback_policy(rd_val, v_val)

        # print(f"[FALLBACK RESULT] {tok} | {msg}", flush=True)

        control.set(tok)
        instruction.set(msg)
    =}
}


reactor Planner {
  input ctrl
  input instr
  input s
  input v
  output act
  output planned_instr

  state last_warn_ns = -10000000000000
  state last_act_ns = -1000000000000
  state speech_proc
  state reached = False
  state stable_count = 0

  preamble{=
    import subprocess
    import re

    # def speak(self, msg):
    #     import re
    #     if not msg:
    #         return

    #     def convert_mps_to_kmph(match):
