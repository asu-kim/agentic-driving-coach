target Python {keepalive: true}

import SensorInputs from "SensorInputs.lf"

reactor Driver{
    input start_signal
    state started = False
    state steer_val = 2
    state accel_val = 0.0
    state brake_val = 0.0
    state head_val = 5

    output steer
    output accelerator
    output brake
    output head
    timer sensorclock(0, 100 msec)

    sen = new SensorInputs()

    reaction(start_signal) {=
        self.started = True
    =}

    // reaction(sen.eye_msg, sen.head_msg, sen.steer_msg, sen.accel_msg, sen.brake_msg)-> accelerator, brake, steer, head {=
    //     if not self.started:
    //         return

    //     head1 = sen.head_msg.value if sen.head_msg.is_present else 5
    //     steer1 = sen.steer_msg.value if sen.steer_msg.is_present else 2
    //     brake1 = sen.brake_msg.value if sen.brake_msg.is_present else 0.0
    //     accelerator1 = sen.accel_msg.value if sen.accel_msg.is_present else 0.0

    //     steer.set(steer1)
    //     accelerator.set(accelerator1)
    //     brake.set(brake1)
    //     head.set(head1)

    //     print("---------------------------------------")
    //     print(f"from driver head: {head1} \n")
    //     print(f"from driver brake: {brake1} \n")
    //     print(f"from driver accelerator: {accelerator1} \n")
    //     print(f"from driver steer: {steer1} \n")
    //     print("---------------------------------------")
    // =}
    #to store the state variable
    reaction(sen.eye_msg, sen.head_msg, sen.steer_msg, sen.accel_msg, sen.brake_msg) {=
        if not self.started:
            return

        if sen.head_msg.is_present:
            self.head_val = sen.head_msg.value

        if sen.steer_msg.is_present:
            self.steer_val = sen.steer_msg.value

        if sen.accel_msg.is_present:
            self.accel_val = sen.accel_msg.value

        if sen.brake_msg.is_present:
            self.brake_val = sen.brake_msg.value
    =}
    reaction(sensorclock) -> accelerator, brake, steer, head {=
        if not self.started:
            return

        steer.set(self.steer_val)
        accelerator.set(self.accel_val)
        brake.set(self.brake_val)
        head.set(self.head_val)

        print("----- sensor clock-----")
        print(f"steer={self.steer_val} accel={self.accel_val} brake={self.brake_val}")
    =}
}

reactor Car{
    input start_signal
    state started = False

    input steer_in
    input accel_in
    input brake_in
    input actuate_in 
    input head_pos_in  

    state acceleration_net
    state velocity_init = 0.0
    state dist_init = 0.0

    output velocity
    output steer
    output head_pos

    reaction(start_signal) {=
        self.started = True
    =}

    reaction(accel_in, brake_in, steer_in, actuate_in, head_pos_in)->velocity, steer, head_pos {=
        if not self.started:
            return

        amsg = accel_in.value if accel_in.is_present else 0.0
        bmsg = brake_in.value if brake_in.is_present else 0.0
        amsg = 0.0 if amsg is None else float(amsg)
        bmsg = 0.0 if bmsg is None else float(bmsg)
        act  = actuate_in.value if actuate_in.is_present else None

        smsg = steer_in.value if steer_in.is_present else 2
        hmsg = head_pos_in.value if head_pos_in.is_present else 5

        def acel_cal(p):
            p = max(0.0, min(1.0, p))
            if p<0.1:
                return p
            elif p<0.6:
                return 2.4 * p
            else:
                return 4.0*(p**2)

        def brake_cal(p):
            p = max(0.0, min(1.0, p))
            if p<0.1:
                return p
            elif p<0.6:
                return -(5.4 * p)
            else:
                return -(9.0*(p**2))

        if act == 11:
            self.acceleration_net = -9.0
        else:
            if bmsg > 0.0:
                self.acceleration_net = brake_cal(bmsg)
            elif amsg > 0.0:
                self.acceleration_net = acel_cal(amsg)
            else:
                self.acceleration_net = -0.5

        vel = self.velocity_init + self.acceleration_net * 0.1

        if vel < 0.0:
            vel = 0.0

        d = self.dist_init + vel * 0.1

        print(f"from car Velocity: {vel}", flush=True)
        print(f"from car Distance: {d}", flush=True)

        velocity.set(vel)
        steer.set(smsg)
        head_pos.set(hmsg)

        self.velocity_init = vel
        self.dist_init = d
    =}
}

reactor Environment{
    input start_signal
    state started = False

    input v
    state pos_speed_change = 100.0
    state passed = False
    output displacement

    reaction(start_signal) {=
        self.started = True
    =}
 
    reaction(v)->displacement {=
        if not self.started:
            return

        vn = float(v.value)
        step = vn * 0.1

        if not self.passed:
            self.pos_speed_change -= step
            if self.pos_speed_change <= 0.0:
                self.pos_speed_change = 0.0
                self.passed = True

            displacement.set(self.pos_speed_change)
        else:
            displacement.set(0.0)

        print(f"displacement from the environment: {displacement.value}", flush=True)
    =}
}

reactor LLMInference {
    input s
    input v
    input st 
    input h

    output ready
    output control
    output instruction

    state last_dl_tok = ""
    state last_dl_msg = ""
    state is_ready = False

    preamble{=
        import ollama
        import time
        from enum import Enum

       

        def run_llm_message(self, rd_val, v_val):
            import ollama
            import time

            print(">>> ENTERING LLM CALL", flush=True)
            t0 = time.perf_counter()

            ALLOWED = {"NONE", "WARNING", "ACTUATE"}

            try:
                r = ollama.chat(
                    model="llama3:8b",
                    messages=[
                        {
                            "role": "system",
                            "content": (
                                "You are an agentic driving coach.\n"
                                "Output exactly ONE line: TOKEN|Message\n\n"

                                "TOKEN must be one of: NONE, WARNING, ACTUATE.\n"
                                "Message must be one sentence about stop sign approaching.\n\n"

                                "Inputs:\n"
                                "- distance_to_stop (s) in meters\n"
                                "- speed (v) in m/s\n\n"

                                "Rules:\n"
                                "- If s <= 25 AND v > 2.5 then TOKEN=ACTUATE\n"
                                "- Else if 50 <= s <= 60 AND (v < 8 OR v > 10) → TOKEN=WARNING\n"
                                "- Else if s >= 99 AND (v < 8 OR v > 12) → TOKEN=WARNING\n"
                                "- Else → TOKEN=NONE\n\n"

                                "If TOKEN=NONE, output exactly: NONE|\n"
                                "Do not output anything else."
                            ),
                        },
                        {
                            "role": "user",
                            "content": f"distance_to_stop={rd_val:.2f}m speed={v_val:.2f}m/s",
                        },
                    ],
                    options={"temperature": 0.0, "num_predict": 30},
                )
            except Exception as e:
                print(">>> LLM ERROR:", e, flush=True)
                return "NONE", "", 0.0

            print(">>> LLM RETURNED", flush=True)

            ms = (time.perf_counter() - t0) * 1000.0
            raw = (r.get("message", {}).get("content", "") or "").strip()

            tok = "NONE"
            msg = ""

            if raw:
                line = raw.splitlines()[0].strip()
                parts = [p.strip() for p in line.split("|", 1)]
                if len(parts) >= 1:
                    tok = parts[0].upper().strip()
                if len(parts) == 2:
                    msg = parts[1].strip()

            # enforce valid token
            if tok not in ALLOWED:
                tok = "NONE"
                msg = ""

            # sanitize message
            msg = msg.replace("$", "").replace("`", "").strip().strip('"').strip("'")

            bad = ["token", "message", "rd=", "v=", "distance_to", "speed="]
            if any(b in msg.lower() for b in bad):
                msg = ""

            # fallback message if empty
            if tok != "NONE" and not msg:
                if tok == "WARNING":
                    msg = "Slow down and prepare to stop."
                elif tok == "ACTUATE":
                    msg = "Brake now."

            if tok == "NONE":
                msg = ""

            return tok, msg, ms
    =}

    reaction(startup) -> ready {=
        import ollama

        print("Loading LLM...", flush=True)

        ollama.chat(
            model="llama3:8b",
            messages=[{"role": "user", "content": "hi"}],
            options={"num_predict": 1}
        )

        print("LLM READY", flush=True)

        self.is_ready = True
        ready.set(True)
    =}

    reaction(s, v, st, h) -> control, instruction {=
        if not self.is_ready:
            print("Waiting for LLM...", flush=True)
            return

        rd_val = s.value if s.value is not None else 0.0
        v_val  = v.value if v.value is not None else 0.0
        st_val = st.value

        if st_val==0:
            steer = "LEFT"
        elif st_val == 1:
            steer = "RIGHT"
        else:
            steer = "CENTER"

        if rd_val <= 0.0:
            control.set("NONE")
            instruction.set("")
            return

        print("#################LoggingforReference###############################", flush=True)
        print(f"[Relative DISTANCE]: {rd_val:.2f}", flush=True)
        print("------------------------------------------------", flush=True)
        print(f"[speed]: {v_val:.2f}", flush=True)
        print("------------------------------------------------", flush=True)
        print(f"[steer]: {steer}", flush=True)
        print("------------------------------------------------", flush=True)
        print("logical", lf.time.logical_elapsed()/1e6, flush=True)
        print("physical", lf.time.physical_elapsed()/1e6, flush=True)

        tok, llm_instruction, ms = self.run_llm_message(rd_val, v_val)

        control.set(tok)
        instruction.set(llm_instruction)

        print(f"[LLM] {ms:.1f} ms -> {tok} | {llm_instruction}", flush=True)
    =}

    deadline(250 msec) {=
        rd_val = s.value if s.value is not None else 0.0
        v_val  = v.value if v.value is not None else 0.0

        if rd_val <= 0.0:
            tok, llm_instruction = "NONE", ""
        else:
            tok, llm_instruction = self.fallback_policy(rd_val, v_val)

        if tok == self.last_dl_tok and llm_instruction == self.last_dl_msg:
            return

        self.last_dl_tok = tok
        self.last_dl_msg = llm_instruction

        control.set(tok)
        instruction.set(llm_instruction)

        print("#################LoggingforReference###############################", flush=True)
        print(f"[Relative DISTANCE]: {rd_val:.2f}", flush=True)
        print("------------------------------------------------", flush=True)
        print(f"[speed]: {v_val:.2f}", flush=True)
        print("------------------------------------------------", flush=True)
        print("logical", lf.time.logical_elapsed()/1e6, flush=True)
        print("physical", lf.time.physical_elapsed()/1e6, flush=True)
        print(f"[DEADLINE] fallback -> {tok} | {llm_instruction}", flush=True)
    =}
}

reactor Planner {
  input ctrl
  input instr
  input s
  input v
  output act
  output planned_instr

  state last_warn_ns = -1000000000000
  state last_printed = ""
  preamble{=
    import os
  =}

  initial mode monitoring {
    
    reaction(ctrl, instr, s, v) -> warning, actuate, planned_instr {=
      throttle = 1000000000
      kw  = (ctrl.value or "NONE").strip()
      instruction = (instr.value or "").strip()
      rd  = s.value if s.value is not None else 0.0
      cmd = f"espeak \"{instruction}\" --stdout | aplay &"

      now_ns = lf.time.logical_elapsed()

      if kw == "ACTUATE" and rd > 0.0:
        if instruction and instruction != self.last_printed:
          i = f"[VERBAL] {kw} | {instruction}"
          planned_instr.set(i)
          if instruction:
            os.system(cmd)
          self.last_printed = instruction
        actuate.set()
        return

      if kw == "WARNING":
        if (now_ns - self.last_warn_ns) >= throttle:
          if instruction and instruction != self.last_printed:
            i = f"[VERBAL] {kw} | {instruction}"
            planned_instr.set(i)
            if instruction:
                os.system(cmd)
            self.last_printed = instruction
          self.last_warn_ns = now_ns
        warning.set()
        return
    =}
  }

  mode warning {
    reaction(ctrl, instr, s, v) -> monitoring, actuate, planned_instr {=
      throttle = 1000000000
      kw  = (ctrl.value or "NONE").strip()
      instruction = (instr.value or "").strip()
      rd  = s.value if s.value is not None else 0.0

      now_ns = lf.time.logical_elapsed()

      if kw == "ACTUATE" and rd > 0.0:
        if instruction and instruction != self.last_printed:
          i = f"[VERBAL] {kw} | {instruction}"
          planned_instr.set(i)
          self.last_printed = instruction
        actuate.set()
        return

      if kw == "NONE":
        monitoring.set()
        return

      if kw == "WARNING":
        if (now_ns - self.last_warn_ns) >= throttle:
          if instruction and instruction != self.last_printed:
            i = f"[VERBAL] {kw} | {instruction}"
            planned_instr.set(i)
            self.last_printed = instruction
          self.last_warn_ns = now_ns
        return
    =}
  }

  mode actuate {
    reaction(ctrl, s, v) -> act, monitoring, planned_instr {=
      kw = (ctrl.value or "NONE").strip()
      rd = s.value if s.value is not None else 0.0

      if kw != "ACTUATE" or rd <= 0.0:
        monitoring.set()
        return

      i = f"[VERBAL] {kw} | Sent EmergencyBraking"
      act.set(11)
      planned_instr.set(i)

      monitoring.set()
    =}
  }
}

reactor Coach{
    input s
    input v
    input st 
    input h

    output act
    output instr
    output ready

    state s_val = 0.0
    state v_val = 0.0
    state st_val = 2
    state h_val = 5

    timer coachclock(0, 100 msec)

    llm = new LLMInference()
    a = new Planner()

    llm.control -> a.ctrl
    llm.instruction -> a.instr

    a.act -> act
    a.planned_instr -> instr

    llm.ready -> ready

    reaction(s, v, st, h) {=
        if s.is_present:
            self.s_val = s.value
        if v.is_present:
            self.v_val = v.value
        if st.is_present:
            self.st_val = st.value
        if h.is_present:
            self.h_val = h.value
    =}

    reaction(coachclock) {=
        # if not llm.is_ready:
        #     return

        llm.s.set(self.s_val)
        llm.v.set(self.v_val)
        llm.st.set(self.st_val)
        llm.h.set(self.h_val)

        print("----- coach clock -----")
        print(f"s={self.s_val} v={self.v_val}", flush=True)
    =}
}

federated reactor at 10.218.100.78 {
    d = new Driver()
    c = new Car()
    en = new Environment()
    adc = new Coach()

    adc.ready -> d.start_signal
    adc.ready -> c.start_signal
    adc.ready -> en.start_signal

    d.accelerator -> c.accel_in 
    d.brake -> c.brake_in 
    d.steer -> c.steer_in 
    d.head -> c.head_pos_in 

    c.velocity -> en.v
    c.velocity -> adc.v
    c.steer -> adc.st
    c.head_pos -> adc.h

    en.displacement -> adc.s

    adc.act -> c.actuate_in after 200 ms
}