target Python {keepalive: true}

import SensorInputs from "SensorInputs.lf"
preamble{=
    import time
    import subprocess
=}

reactor Driver{
    input start_signal
    state started = False
    state steer_val = 2
    state accel_val = 0.0
    state brake_val = 0.0
    state head_val = 5

    output steer
    output accelerator
    output brake
    output head
    timer sensorclock(0, 250 msec)

    sen = new SensorInputs()

    reaction(start_signal) {=
        self.started = True
    =}

    
    reaction(sen.eye_msg, sen.head_msg, sen.steer_msg, sen.accel_msg, sen.brake_msg) {=
        if not self.started:
            return

        if sen.head_msg.is_present:
            self.head_val = sen.head_msg.value

        if sen.steer_msg.is_present:
            self.steer_val = sen.steer_msg.value

        if sen.accel_msg.is_present:
            self.accel_val = sen.accel_msg.value

        if sen.brake_msg.is_present:
            self.brake_val = sen.brake_msg.value
    =}
    reaction(sensorclock) -> accelerator, brake, steer, head {=
        if not self.started:
            return
        current_dri = lf.time.logical_elapsed()/1e6
        steer.set(self.steer_val)
        accelerator.set(self.accel_val)
        brake.set(self.brake_val)
        head.set(self.head_val)

        print("----- sensor clock-----")
        print(f"[DRIVER] logical time: {current_dri:.2f} steer={self.steer_val} accel={self.accel_val} brake={self.brake_val}")
    =}
}

reactor Car{
    input start_signal
    state started = False

    input steer_in
    input accel_in
    input brake_in
    input actuate_in 
    input head_pos_in  

    state acceleration_net
    state velocity_init = 30
    state dist_init = 0.0
  
    state accel_val = 0.0
    state brake_val = 0.0
    state steer_val = 2
    state head_val = 5
    state act_val 

    output velocity
    output steer
    output head_pos

    reaction(start_signal) {=
        self.started = True
    =}
    reaction(accel_in, brake_in, steer_in, actuate_in, head_pos_in)-> velocity, steer, head_pos {=
        if not self.started:
            return
        if accel_in.is_present:
            self.accel_val = float(accel_in.value)

        if brake_in.is_present:
            self.brake_val = float(brake_in.value)

        if steer_in.is_present:
            self.steer_val = steer_in.value

        if head_pos_in.is_present:
            self.head_val = head_pos_in.value

        if actuate_in.is_present:
            self.act_val = actuate_in.value

        current_dri = lf.time.logical_elapsed()/1e6
        amsg = self.accel_val
        bmsg = self.brake_val
        act  = self.act_val

        def acel_cal(p):
            p = max(0.0, min(1.0, p))
            if p < 0.1:
                return p
            elif p < 0.6:
                return 2.4 * p
            else:
                return 4.0 * (p**2)

        def brake_cal(p):
            p = max(0.0, min(1.0, p))
            if p < 0.1:
                return p
            elif p < 0.6:
                return -(5.4 * p)
            else:
                return -(9.0 * (p**2))

        
        if act == 11:
            acc_net = -9.0
        else:
            if bmsg > 0.15:          # dead zone (fixes your issue)
                acc_net = brake_cal(bmsg)
            elif amsg > 0.05:        # small threshold
                acc_net = acel_cal(amsg)
            else:
                acc_net = 0.0        # NOT -0.1 (was slowing you down always)

       
        vel = self.velocity_init + acc_net * 0.1
        vel = max(0.0, vel)

        d = self.dist_init + vel * 0.1

        print(f"[CAR CLOCK] logical time: {current_dri:.2f} vel={vel} acc={acc_net}", flush=True)

        velocity.set(vel)
        steer.set(self.steer_val)
        head_pos.set(self.head_val)

        self.velocity_init = vel
        self.dist_init = d
    =}

    
    
}

reactor Environment{
    input start_signal
    state started = False

    input v
    state pos_speed_change = 100.0
    state passed = False
    output displacement
    // timer envclock(0, 100 msec)
    state v_val = 0.0

    reaction(start_signal) {=
        self.started = True
    =}
    reaction(v) -> displacement{=
        if not self.started:
            return
        if v.is_present:
            self.v_val = float(v.value)
        current_dri = lf.time.logical_elapsed()/1e6
        

        step = self.v_val * 0.1

        if not self.passed:
            self.pos_speed_change -= step

            if self.pos_speed_change <= 0.0:
                self.pos_speed_change = 0.0
                self.passed = True

            displacement.set(self.pos_speed_change)
        else:
            displacement.set(0.0)

        print(f"[ENV CLOCK] logical time: {current_dri:.2f} disp={self.pos_speed_change}", flush=True)
    =}
 
    
    
}



reactor LLMInference {
    input s
    input v
    input st 
    input h

    output ready
    output control
    output instruction

    state last_dl_tok = ""
    state last_dl_msg = ""
    state is_ready = False
    state s_val = 0.0
    state v_val = 0.0
    state st_val = 2
    state h_val = 5

    timer llmclock(0, 250 msec)

    preamble{=
        import ollama
        import time

        def run_llm_message(self, rd_val, v_val):
            import ollama
            import time
            # print(">>> ENTERING LLM CALL", flush=True)
            t0 = time.perf_counter()

            try:
                r = ollama.chat(
                    model="llama3:8b",
                    messages=[
                        {
                            "role": "system",
                            "content": (
                                "Output exactly ONE line: TOKEN|Message\n"
                                "TOKEN must be one of: NONE, WARNING, ACTUATE\n"
                                "Message must be one sentence about speed change only.\n"
                                "distance_to_sign is s (meters), velocity is v (m/s)\n\n"

                                "Rules:\n"
                                "- If s <= 25 and (v < 11 or v > 12) → ACTUATE\n"
                                "- If 50 <= s <= 60 and (v < 13 or v > 15) → WARNING\n"
                                "- If s >= 80 and (v < 16 or v > 18) → WARNING\n"
                                "- Otherwise → NONE\n\n"

                                "Strict output format:\n"
                                "TOKEN|Message\n"

                                "If TOKEN=NONE, output exactly:\n"
                                "NONE|\n"

                                "Do NOT output anything else."
                            )
                        },
                        {
                            "role": "user",
                            "content": f"s={rd_val:.2f}, v={v_val:.2f}"
                        }
                    ],
                    options={"temperature": 0.0, "num_predict": 30},
                )
            except Exception as e:
                print(">>> LLM ERROR:", e, flush=True)
                return "NONE", "", 0.0

            ms = (time.perf_counter() - t0) * 1000.0
            raw = (r.get("message", {}).get("content", "") or "").strip()

            # print(f">>> RAW LLM OUTPUT: {raw}", flush=True)

            return "NONE", raw, ms

        def fallback_policy(self, rd_val, v_val):
            # print(f"[FALLBACK POLICY] evaluating s={rd_val:.2f}, v={v_val:.2f}", flush=True)

            if rd_val <= 0.0:
                return "NONE", ""

            if rd_val <= 25:
                return "ACTUATE", "Brake now."

            if rd_val >= 80:
                return "WARNING", "Speed limit ahead."

            return "NONE", ""
    =}

    reaction(startup) -> ready {=
        import time
        print("\n=== STARTUP ===", flush=True)
        print(f"[TIME] logical={lf.time.logical_elapsed()/1e6:.2f}", flush=True)
        print(f"[TIME] physical={lf.time.physical_elapsed()/1e6:.2f}", flush=True)

        self.is_ready = True
        ready.set(True)

        print("[STATUS] LLM READY", flush=True)
    =}

    reaction(s, v, st, h){=
        # print("\n=== INPUT REACTION TRIGGERED ===", flush=True)
        # print(f"[TIME] logical={lf.time.logical_elapsed()/1e6:.2f}", flush=True)
        # print(f"[TIME] physical={lf.time.physical_elapsed()/1e6:.2f}", flush=True)

        # print(f"[PRESENCE] s={s.is_present}, v={v.is_present}, st={st.is_present}, h={h.is_present}", flush=True)

        if s.is_present:
            self.s_val = s.value
        if v.is_present:
            self.v_val = v.value
        if st.is_present:
            self.st_val = st.value
        if h.is_present:
            self.h_val = h.value

        # print(f"[STATE UPDATE] s_val={self.s_val:.2f}, v_val={self.v_val:.2f}", flush=True)

    =}

    reaction(llmclock) -> control, instruction {=
        # print("\n=== LLM CLOCK TRIGGERED ===", flush=True)

        current_logical = lf.time.logical_elapsed()/1e6
        # print(f"[TIME] logical={current_logical:.2f}", flush=True)

        if not self.is_ready:
            # print("[SKIP] LLM not ready", flush=True)
            return

        rd_val = self.s_val
        v_val  = self.v_val

        # print(f"[STATE READ] s={rd_val:.2f}, v={v_val:.2f}", flush=True)

        if rd_val <= 0.0:
            control.set("NONE")
            instruction.set("")
            return

        # print("[LLM] calling model...", flush=True)

        tok_raw, msg_raw, ms = self.run_llm_message(rd_val, v_val)
        self.check_deadline()

        raw = (msg_raw or "").strip()

        if "|" in raw:
            tok, msg = raw.split("|", 1)
        else:
            tok = tok_raw or "NONE"
            msg = raw

        tok = tok.strip()
        msg = msg.strip()

        # print(f"[LLM RESULT] {tok} | {msg} | {ms:.2f} ms", flush=True)

        control.set(tok)
        instruction.set(msg)

    =} 
    deadline(100 sec) {=
        # print("\n=== DEADLINE TRIGGERED ===", flush=True)

        rd_val = self.s_val
        v_val  = self.v_val

        tok, msg = self.fallback_policy(rd_val, v_val)

        # print(f"[FALLBACK RESULT] {tok} | {msg}", flush=True)

        control.set(tok)
        instruction.set(msg)
    =}
}


