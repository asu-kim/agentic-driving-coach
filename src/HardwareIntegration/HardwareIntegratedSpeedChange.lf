target Python {keepalive: true}

import SensorInputs from "SensorInputs.lf"

reactor Driver{
    input start_signal
    state started = False
    state steer_val = 2
    state accel_val = 0.0
    state brake_val = 0.0
    state head_val = 5

    output steer
    output accelerator
    output brake
    output head
    timer sensorclock(0, 100 msec)

    sen = new SensorInputs()

    reaction(start_signal) {=
        self.started = True
    =}

    
    reaction(sen.eye_msg, sen.head_msg, sen.steer_msg, sen.accel_msg, sen.brake_msg) {=
        if not self.started:
            return

        if sen.head_msg.is_present:
            self.head_val = sen.head_msg.value

        if sen.steer_msg.is_present:
            self.steer_val = sen.steer_msg.value

        if sen.accel_msg.is_present:
            self.accel_val = sen.accel_msg.value

        if sen.brake_msg.is_present:
            self.brake_val = sen.brake_msg.value
    =}
    reaction(sensorclock) -> accelerator, brake, steer, head {=
        if not self.started:
            return
        current_dri = lf.time.logical_elapsed()/1e6
        steer.set(self.steer_val)
        accelerator.set(self.accel_val)
        brake.set(self.brake_val)
        head.set(self.head_val)

        print("----- sensor clock-----")
        print(f"[DRIVER] logical time: {current_dri:.2f} steer={self.steer_val} accel={self.accel_val} brake={self.brake_val}")
    =}
}

reactor Car{
    input start_signal
    state started = False

    input steer_in
    input accel_in
    input brake_in
    input actuate_in 
    input head_pos_in  

    state acceleration_net
    state velocity_init = 0.0
    state dist_init = 0.0
    timer carclock(0, 100 msec)
    state accel_val = 0.0
    state brake_val = 0.0
    state steer_val = 2
    state head_val = 5
    state act_val 

    output velocity
    output steer
    output head_pos

    reaction(start_signal) {=
        self.started = True
    =}
    reaction(accel_in, brake_in, steer_in, actuate_in, head_pos_in) {=
        if accel_in.is_present:
            self.accel_val = float(accel_in.value)

        if brake_in.is_present:
            self.brake_val = float(brake_in.value)

        if steer_in.is_present:
            self.steer_val = steer_in.value

        if head_pos_in.is_present:
            self.head_val = head_pos_in.value

        if actuate_in.is_present:
            self.act_val = actuate_in.value
    =}

    
    reaction(carclock) -> velocity, steer, head_pos {=
        if not self.started:
            return
        current_dri = lf.time.logical_elapsed()/1e6
        amsg = self.accel_val
        bmsg = self.brake_val
        act  = self.act_val

        def acel_cal(p):
            p = max(0.0, min(1.0, p))
            if p < 0.1:
                return p
            elif p < 0.6:
                return 2.4 * p
            else:
                return 4.0 * (p**2)

        def brake_cal(p):
            p = max(0.0, min(1.0, p))
            if p < 0.1:
                return p
            elif p < 0.6:
                return -(5.4 * p)
            else:
                return -(9.0 * (p**2))

        
        if act == 11:
            acc_net = -9.0
        else:
            if bmsg > 0.15:          # dead zone (fixes your issue)
                acc_net = brake_cal(bmsg)
            elif amsg > 0.05:        # small threshold
                acc_net = acel_cal(amsg)
            else:
                acc_net = 0.0        # NOT -0.1 (was slowing you down always)

       
        vel = self.velocity_init + acc_net * 0.1
        vel = max(0.0, vel)

        d = self.dist_init + vel * 0.1

        print(f"[CAR CLOCK] logical time: {current_dri:.2f} vel={vel} acc={acc_net}", flush=True)

        velocity.set(vel)
        steer.set(self.steer_val)
        head_pos.set(self.head_val)

        self.velocity_init = vel
        self.dist_init = d
    =}
}

reactor Environment{
    input start_signal
    state started = False

    input v
    state pos_speed_change = 100.0
    state passed = False
    output displacement
    timer envclock(0, 100 msec)
    state v_val = 0.0

    reaction(start_signal) {=
        self.started = True
    =}
    reaction(v) {=
        if v.is_present:
            self.v_val = float(v.value)
    =}
 
    
    reaction(envclock) -> displacement {=
        if not self.started:
            return
        current_dri = lf.time.logical_elapsed()/1e6
        

        step = self.v_val * 0.1

        if not self.passed:
            self.pos_speed_change -= step

            if self.pos_speed_change <= 0.0:
                self.pos_speed_change = 0.0
                self.passed = True

            displacement.set(self.pos_speed_change)
        else:
            displacement.set(0.0)

        print(f"[ENV CLOCK] logical time: {current_dri:.2f} disp={self.pos_speed_change}", flush=True)
    =}
}

reactor LLMInference {
    input s
    input v
    input st 
    input h

    output ready
    output control
    output instruction

    state last_dl_tok = ""
    state last_dl_msg = ""
    state is_ready = False
    state s_val = 0.0
    state v_val = 0.0
    state st_val = 2
    state h_val = 5
    timer llmclock(0, 100 msec)

    preamble{=
        import ollama
        import time
        from enum import Enum

       

        def run_llm_message(self, rd_val, v_val):
            import ollama
            import time

            print(">>> ENTERING LLM CALL", flush=True)
            t0 = time.perf_counter()

            ALLOWED = {"NONE", "WARNING", "ACTUATE"}

            try:
                r = ollama.chat(
                    model="llama3:8b",
                    messages=[
                        {
                            "role": "system",
                            "content": (
                                "Output exactly ONE line: TOKEN|Message"
                                "TOKEN must be one of: NONE, WARNING, ACTUATE"
                                "Message must be one sentence, about speed change only."
                                "Use distance_to_sign is s and measured in meters"
                                "velocity is v measured using m/s only."

                                "Rules for TOKEN:"
                                "if s is lesser than or equal to 25 and v is greater than 12 or lesser than 11 then TOKEN=ACTUATE\n"
                                "else if s lies in between 50 to 60 and v is in between 15 to 13 then TOKEN=WARNING"
                                "else if s is greater than 80 and v is not in between 18 to 16 then TOKEN=WARNING\n"
                                "else TOKEN=NONE\n"

                                "If TOKEN=NONE, output: NONE|\n"
                                "Do not output anything else."
                            ),
                        },
                        {
                            "role": "user",
                            "content": f"distance_to_stop={rd_val:.2f}m speed={v_val:.2f}m/s",
                        },
                    ],
                    options={"temperature": 0.0, "num_predict": 30},
                )
            except Exception as e:
                print(">>> LLM ERROR:", e, flush=True)
                return "NONE", "", 0.0

            print(">>> LLM RETURNED", flush=True)

            ms = (time.perf_counter() - t0) * 1000.0
            raw = (r.get("message", {}).get("content", "") or "").strip()

            tok = "NONE"
            msg = ""

            if raw:
                line = raw.splitlines()[0].strip()
                parts = [p.strip() for p in line.split("|", 1)]
                if len(parts) >= 1:
                    tok = parts[0].upper().strip()
                if len(parts) == 2:
                    msg = parts[1].strip()

            # enforce valid token
            if tok not in ALLOWED:
                tok = "NONE"
                msg = ""

            # sanitize message
            msg = msg.replace("$", "").replace("`", "").strip().strip('"').strip("'")

            bad = ["token", "message", "rd=", "v=", "distance_to", "speed="]
            if any(b in msg.lower() for b in bad):
                msg = ""

            # fallback message if empty
            if tok != "NONE" and not msg:
                if tok == "WARNING":
                    msg = "Slow down and prepare to stop."
                elif tok == "ACTUATE":
                    msg = "Brake now."

            if tok == "NONE":
                msg = ""

            return tok, msg, ms
        def fallback_policy(self, rd_val, v_val):
                if rd_val <= 0.0:
                    return "NONE", ""

                if rd_val <= 25 and (v_val>12 or v_val<11):
                    return "ACTUATE", "Brake now."

                if rd_val >= 80.0 and (v_val > 18 or v_val<16) :
                    return "WARNING", "Speed limit change ahead."
                if 50.0 < rd_val <= 60.0 and (v_val > 15 or v_val<13):
                    return "WARNING", "Slow down to 11 m/s."

                return "NONE", ""
    =}

    reaction(startup) -> ready {=
        import ollama

        print("Loading LLM...", flush=True)

        ollama.chat(
            model="llama3:8b",
            messages=[{"role": "user", "content": "hi"}],
            options={"num_predict": 1}
        )

        print("LLM READY", flush=True)

        self.is_ready = True
        ready.set(True)
    =}
    reaction(s, v, st, h) {=
        if s.is_present:
            self.s_val = s.value
        if v.is_present:
            self.v_val = v.value
        if st.is_present:
            self.st_val = st.value
        if h.is_present:
            self.h_val = h.value

        print(f"[LLM INPUT] t={lf.time.logical_elapsed()/1e6:.2f} s={self.s_val:.2f} v={self.v_val:.2f}", flush=True)
    =}

    
    reaction(llmclock) -> control, instruction {=
        current = lf.time.logical_elapsed()/1e6

        print("\n===== LLM CLOCK =====", flush=True)
        print(f"time={current:.2f}", flush=True)

        if not self.is_ready:
            print("LLM not ready", flush=True)
            return

        rd_val = self.s_val
        v_val  = self.v_val

        print(f"state: s={rd_val:.2f}, v={v_val:.2f}", flush=True)

        # if rd_val <= 0.0:
        #     control.set("NONE")
        #     instruction.set("")
        #     return

        print("calling LLM...", flush=True)

        # tok, msg, ms = self.run_llm_message(rd_val, v_val)
        t0 = lf.time.physical_elapsed()

        if rd_val <= 25 and v_val > 2.5:
            tok = "ACTUATE"
            msg = "Brake now."
        elif 50 <= rd_val <= 60:
            tok = "WARNING"
            msg = "Slow down."
        else:
            tok = "NONE"
            msg = ""

        ms = lf.time.physical_elapsed() - t0

        print(f"[DUMMY LLM] {tok} | {msg} ({ms:.2f} ms)", flush=True)

        control.set(tok)
        instruction.set(msg)
    =}

    deadline(1500 msec) {=
        current = lf.time.logical_elapsed()/1e6

        print("\n===== deadline start time =====", flush=True)
        print(f"time={current:.2f}", flush=True)
        rd_val = self.s_val
        v_val  = self.v_val

        if rd_val <= 0.0:
            tok, llm_instruction = "NONE", ""
        else:
            tok, llm_instruction = self.fallback_policy(rd_val, v_val)

        if tok == self.last_dl_tok and llm_instruction == self.last_dl_msg:
            return

        self.last_dl_tok = tok
        self.last_dl_msg = llm_instruction

        control.set(tok)
        instruction.set(llm_instruction)

        print("#################LoggingforReference###############################", flush=True)
        print(f"[Relative DISTANCE]: {rd_val:.2f}", flush=True)
        print("------------------------------------------------", flush=True)
        print(f"[speed]: {v_val:.2f}", flush=True)
        print("------------------------------------------------", flush=True)
        print("logical", lf.time.logical_elapsed()/1e6, flush=True)
        print("physical", lf.time.physical_elapsed()/1e6, flush=True)
        print(f"[DEADLINE] fallback -> {tok} | {llm_instruction}", flush=True)
    =}
}

reactor Planner {
  input ctrl
  input instr
  input s
  input v
  output act
  output planned_instr

  state last_warn_ns = -1000000000000
  state last_printed = ""
  preamble{=
    import os
  =}

  initial mode monitoring {
    
    reaction(ctrl, instr, s, v) -> warning, actuate, planned_instr {=
      throttle = 1000000000
      kw  = (ctrl.value or "NONE").strip()
      instruction = (instr.value or "").strip()
      rd  = s.value if s.value is not None else 0.0
      cmd = f"espeak \"{instruction}\" --stdout | aplay &"

      now_ns = lf.time.logical_elapsed()

      if kw == "ACTUATE" and rd > 0.0:
        if instruction and instruction != self.last_printed:
          i = f"[VERBAL] {kw} | {instruction}"
          planned_instr.set(i)
          if instruction:
            os.system(cmd)
          self.last_printed = instruction
        actuate.set()
        return

      if kw == "WARNING":
        if (now_ns - self.last_warn_ns) >= throttle:
          if instruction and instruction != self.last_printed:
            i = f"[VERBAL] {kw} | {instruction}"
            planned_instr.set(i)
            if instruction:
                os.system(cmd)
            self.last_printed = instruction
          self.last_warn_ns = now_ns
        warning.set()
        return
    =}
  }

  mode warning {
    reaction(ctrl, instr, s, v) -> monitoring, actuate, planned_instr {=
      throttle = 1000000000
      kw  = (ctrl.value or "NONE").strip()
      instruction = (instr.value or "").strip()
      rd  = s.value if s.value is not None else 0.0
      cmd = f"espeak \"{instruction}\" --stdout | aplay &"


      now_ns = lf.time.logical_elapsed()

      if kw == "ACTUATE" and rd > 0.0:
        if instruction and instruction != self.last_printed:
          i = f"[VERBAL] {kw} | {instruction}"
          planned_instr.set(i)
          if instruction:
            os.system(cmd)
          self.last_printed = instruction
        actuate.set()
        return

      if kw == "NONE":
        monitoring.set()
        return

      if kw == "WARNING":
        if (now_ns - self.last_warn_ns) >= throttle:
          if instruction and instruction != self.last_printed:
            i = f"[VERBAL] {kw} | {instruction}"
            planned_instr.set(i)
            if instruction:
                os.system(cmd)
            self.last_printed = instruction
          self.last_warn_ns = now_ns
        return
    =}
  }

  mode actuate {
    reaction(ctrl, s, v) -> act, monitoring, planned_instr {=
      kw = (ctrl.value or "NONE").strip()
      rd = s.value if s.value is not None else 0.0
      cmd = f"espeak \"{instruction}\" --stdout | aplay &"


      if kw != "ACTUATE" or rd <= 0.0:
        monitoring.set()
        return

      i = f"[VERBAL] {kw} | Sent EmergencyBraking"
      act.set(11)
      planned_instr.set(i)
      if instruction:
            os.system(cmd)

      monitoring.set()
    =}
  }
}

reactor Coach{
    input s
    input v
    input st 
    input h

    

    output act
    output instr
    output ready

    llm = new LLMInference()
    a = new Planner()
    s -> llm.s
    v -> llm.v
    st -> llm.st
    h -> llm.h
   
    llm.control -> a.ctrl
    llm.instruction -> a.instr

    a.act -> act
    a.planned_instr -> instr

    llm.ready -> ready

    
}

federated reactor at 10.218.100.78 {
    d = new Driver()
    c = new Car()
    en = new Environment()
    adc = new Coach()

    adc.ready -> d.start_signal
    adc.ready -> c.start_signal
    adc.ready -> en.start_signal

    d.accelerator -> c.accel_in 
    d.brake -> c.brake_in 
    d.steer -> c.steer_in 
    d.head -> c.head_pos_in 

    c.velocity -> en.v
    c.velocity -> adc.v
    c.steer -> adc.st
    c.head_pos -> adc.h

    en.displacement -> adc.s

    adc.act -> c.actuate_in after 200 ms
}