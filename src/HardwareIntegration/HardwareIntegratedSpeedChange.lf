reactor Planner {
  input ctrl
  input instr
  input s
  input v
  output act
  output planned_instr

  state last_warn_ns = -10000000000000
  state last_act_ns = -1000000000000
  state last_printed = ""
  state speech_proc 
  state reached = False

  preamble{=
    import subprocess
  =}

  initial mode monitoring {
    
    reaction(ctrl, instr, s, v) -> warning, actuate, planned_instr {=
      throttle = 3000000000
      kw  = (ctrl.value or "NONE").strip()
      instruction = (instr.value or "").strip()
      rd  = s.value if s.value is not None else 0.0
      v_val = v.value if v.value is not None else 0.0

      print(f"[DATA] v={v_val:.2f} | s={rd:.2f}", flush=True)

      now_ns = lf.time.logical_elapsed()

      if rd <= 5.0 and not self.reached:
        log = f"[LOG] v={v_val:.2f} | s={rd:.2f} | REACHED | Stopped near sign"
        print(log, flush=True)
        planned_instr.set(log)
        act.set(11)

        try:
          if self.speech_proc is not None:
            self.speech_proc.kill()
        except:
          pass

        self.speech_proc = subprocess.Popen(
          ["espeak", "-s", "130", "You have reached the stop sign"],
          stdout=subprocess.DEVNULL,
          stderr=subprocess.DEVNULL
        )

        self.reached = True
        return

      if kw == "ACTUATE" and rd > 0.0:
        actuate.set()

        act_throttle = 1500000000

        if (now_ns - self.last_act_ns) >= act_throttle:
          if instruction:
            log = f"[LOG] v={v_val:.2f} | s={rd:.2f} | {kw} | {instruction}"
            print(log, flush=True)
            planned_instr.set(log)

            try:
              if self.speech_proc is not None:
                self.speech_proc.kill()
            except:
              pass

            self.speech_proc = subprocess.Popen(
              ["espeak", "-s", "140", instruction],
              stdout=subprocess.DEVNULL,
              stderr=subprocess.DEVNULL
            )

          self.last_act_ns = now_ns
        return

      if kw == "WARNING":
        if (now_ns - self.last_warn_ns) >= throttle:
          if instruction:
            log = f"[LOG] v={v_val:.2f} | s={rd:.2f} | {kw} | {instruction}"
            print(log, flush=True)
            planned_instr.set(log)

            try:
              if self.speech_proc is not None:
                self.speech_proc.kill()
            except:
              pass

            self.speech_proc = subprocess.Popen(
              ["espeak", "-s", "140", instruction],
              stdout=subprocess.DEVNULL,
              stderr=subprocess.DEVNULL
            )

          self.last_warn_ns = now_ns

        warning.set()
        return
    =}
  }

  mode warning {
    reaction(ctrl, instr, s, v) -> monitoring, actuate, planned_instr {=
      throttle = 3000000000
      kw  = (ctrl.value or "NONE").strip()
      instruction = (instr.value or "").strip()
      rd  = s.value if s.value is not None else 0.0
      v_val = v.value if v.value is not None else 0.0

      print(f"[DATA] v={v_val:.2f} | s={rd:.2f}", flush=True)

      now_ns = lf.time.logical_elapsed()

      if rd <= 5.0 and not self.reached:
        log = f"[LOG] v={v_val:.2f} | s={rd:.2f} | REACHED | Stopped near sign"
        print(log, flush=True)
        planned_instr.set(log)
        act.set(11)

        try:
          if self.speech_proc is not None:
            self.speech_proc.kill()
        except:
          pass

        self.speech_proc = subprocess.Popen(
          ["espeak", "-s", "130", "You have reached the stop sign"],
          stdout=subprocess.DEVNULL,
          stderr=subprocess.DEVNULL
        )

        self.reached = True
        return

      if kw == "ACTUATE" and rd > 0.0:
        actuate.set()

        act_throttle = 1500000000

        if (now_ns - self.last_act_ns) >= act_throttle:
          if instruction:
            log = f"[LOG] v={v_val:.2f} | s={rd:.2f} | {kw} | {instruction}"
            print(log, flush=True)
            planned_instr.set(log)

            try:
              if self.speech_proc is not None:
                self.speech_proc.kill()
            except:
              pass

            self.speech_proc = subprocess.Popen(
              ["espeak", "-s", "140", instruction],
              stdout=subprocess.DEVNULL,
              stderr=subprocess.DEVNULL
            )

          self.last_act_ns = now_ns
        return

      if kw == "NONE":
        monitoring.set()
        return

      if kw == "WARNING":
        if (now_ns - self.last_warn_ns) >= throttle:
          if instruction:
            log = f"[LOG] v={v_val:.2f} | s={rd:.2f} | {kw} | {instruction}"
            print(log, flush=True)
            planned_instr.set(log)

            try:
              if self.speech_proc is not None:
                self.speech_proc.kill()
            except:
              pass

            self.speech_proc = subprocess.Popen(
              ["espeak", "-s", "140", instruction],
              stdout=subprocess.DEVNULL,
              stderr=subprocess.DEVNULL
            )

          self.last_warn_ns = now_ns
        return
    =}
  }

  mode actuate {
    reaction(ctrl, instr, s, v) -> act, monitoring, planned_instr {=
        kw = (ctrl.value or "NONE").strip()
        rd = s.value if s.value is not None else 0.0
        v_val = v.value if v.value is not None else 0.0
        instruction = (instr.value or "").strip()   

        print(f"[DATA] v={v_val:.2f} | s={rd:.2f}", flush=True)

        now_ns = lf.time.logical_elapsed()

        if rd <= 5.0 and not self.reached:
            log = f"[LOG] v={v_val:.2f} | s={rd:.2f} | REACHED | Stopped near sign"
            print(log, flush=True)
            planned_instr.set(log)
            act.set(11)

            try:
                if self.speech_proc is not None:
                    self.speech_proc.kill()
            except:
                pass

            self.speech_proc = subprocess.Popen(
                ["espeak", "-s", "130", "You have reached the stop sign"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )

            self.reached = True
            return

        if kw != "ACTUATE" or rd <= 0.0:
            monitoring.set()
            return

        act.set(11)

        act_throttle = 1500000000

        if (now_ns - self.last_act_ns) >= act_throttle:
            if instruction:
                log = f"[LOG] v={v_val:.2f} | s={rd:.2f} | {kw} | {instruction}"
                print(log, flush=True)
                planned_instr.set(log)

                try:
                    if self.speech_proc is not None:
                        self.speech_proc.kill()
                except:
                    pass

                self.speech_proc = subprocess.Popen(
                    ["espeak", "-s", "135", instruction],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )

            self.last_act_ns = now_ns

        monitoring.set()
    =}
  }
}

reactor Coach{
    input s
    input v
    input st 
    input h

    

    output act
    output instr
    output ready

    llm = new LLMInference()
    a = new Planner()
    s -> llm.s
    v -> llm.v
    st -> llm.st
    h -> llm.h
   
    llm.control -> a.ctrl
    llm.instruction -> a.instr
    s -> a.s
    v -> a.v
    a.act -> act
    a.planned_instr -> instr

    llm.ready -> ready

    
}

federated reactor at 10.218.100.78 {
    d = new Driver()
    c = new Car()
    en = new Environment()
    adc = new Coach()

    adc.ready -> d.start_signal
    adc.ready -> c.start_signal
    adc.ready -> en.start_signal

    d.accelerator -> c.accel_in 
    d.brake -> c.brake_in 
    d.steer -> c.steer_in 
    d.head -> c.head_pos_in 

    c.velocity -> en.v
    c.velocity -> adc.v
    c.steer -> adc.st
    c.head_pos -> adc.h

    en.displacement -> adc.s

    adc.act -> c.actuate_in after 200 ms
}