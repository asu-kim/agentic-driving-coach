reactor LLMInference {
    input s
    input v
    input st 
    input h

    output ready
    output control
    output instruction

    state last_dl_tok = ""
    state last_dl_msg = ""
    state is_ready = False
    state s_val = 0.0
    state v_val = 0.0
    state st_val = 2
    state h_val = 5

    timer llmclock(0, 250 msec)

    preamble{=
        import ollama
        import time

        def run_llm_message(self, rd_val, v_val):
            import ollama
            import time
            print(">>> ENTERING LLM CALL", flush=True)
            t0 = time.perf_counter()

            try:
                r = ollama.chat(
                    model="llama3:8b",
                    messages=[
                        {
                            "role": "system",
                            "content": (
                                "Output exactly ONE line: TOKEN|Message\n"
                                "TOKEN must be one of: NONE, WARNING, ACTUATE\n"
                                "Message must be one sentence about speed change only.\n"
                                "distance_to_sign is s (meters), velocity is v (m/s)\n\n"

                                "Rules:\n"
                                "- If s <= 25 and (v < 11 or v > 12) → ACTUATE\n"
                                "- If 50 <= s <= 60 and (v < 13 or v > 15) → WARNING\n"
                                "- If s >= 80 and (v < 16 or v > 18) → WARNING\n"
                                "- Otherwise → NONE\n\n"

                                "Strict output format:\n"
                                "TOKEN|Message\n"

                                "If TOKEN=NONE, output exactly:\n"
                                "NONE|\n"

                                "Do NOT output anything else."
                            )
                        },
                        {
                            "role": "user",
                            "content": f"s={rd_val:.2f}, v={v_val:.2f}"
                        }
                    ],
                    options={"temperature": 0.0, "num_predict": 30},
                )
            except Exception as e:
                print(">>> LLM ERROR:", e, flush=True)
                return "NONE", "", 0.0

            ms = (time.perf_counter() - t0) * 1000.0
            raw = (r.get("message", {}).get("content", "") or "").strip()

            print(f">>> RAW LLM OUTPUT: {raw}", flush=True)

            return "NONE", raw, ms

        def fallback_policy(self, rd_val, v_val):
            print(f"[FALLBACK POLICY] evaluating s={rd_val:.2f}, v={v_val:.2f}", flush=True)

            if rd_val <= 0.0:
                return "NONE", ""

            if rd_val <= 25:
                return "ACTUATE", "Brake now."

            if rd_val >= 80:
                return "WARNING", "Speed limit ahead."

            return "NONE", ""
    =}

    reaction(startup) -> ready {=
        import time
        print("\n=== STARTUP ===", flush=True)
        print(f"[TIME] logical={lf.time.logical_elapsed()/1e6:.2f}", flush=True)
        print(f"[TIME] physical={lf.time.physical_elapsed()/1e6:.2f}", flush=True)

        self.is_ready = True
        ready.set(True)

        print("[STATUS] LLM READY", flush=True)
    =}

    reaction(s, v, st, h) -> control, instruction {=
        print("\n=== INPUT REACTION TRIGGERED ===", flush=True)
        print(f"[TIME] logical={lf.time.logical_elapsed()/1e6:.2f}", flush=True)
        print(f"[TIME] physical={lf.time.physical_elapsed()/1e6:.2f}", flush=True)

        print(f"[PRESENCE] s={s.is_present}, v={v.is_present}, st={st.is_present}, h={h.is_present}", flush=True)

        if s.is_present:
            self.s_val = s.value
        if v.is_present:
            self.v_val = v.value
        if st.is_present:
            self.st_val = st.value
        if h.is_present:
            self.h_val = h.value

        print(f"[STATE UPDATE] s_val={self.s_val:.2f}, v_val={self.v_val:.2f}", flush=True)

    =}

    reaction(llmclock) -> control, instruction {=
        print("\n=== LLM CLOCK TRIGGERED ===", flush=True)

        current_logical = lf.time.logical_elapsed()/1e6
        print(f"[TIME] logical={current_logical:.2f}", flush=True)

        if not self.is_ready:
            print("[SKIP] LLM not ready", flush=True)
            return

        rd_val = self.s_val
        v_val  = self.v_val

        print(f"[STATE READ] s={rd_val:.2f}, v={v_val:.2f}", flush=True)

        if rd_val <= 0.0:
            control.set("NONE")
            instruction.set("")
            return

        print("[LLM] calling model...", flush=True)

        tok_raw, msg_raw, ms = self.run_llm_message(rd_val, v_val)
        self.check_deadline()

        raw = (msg_raw or "").strip()

        if "|" in raw:
            tok, msg = raw.split("|", 1)
        else:
            tok = tok_raw or "NONE"
            msg = raw

        tok = tok.strip()
        msg = msg.strip()

        print(f"[LLM RESULT] {tok} | {msg} | {ms:.2f} ms", flush=True)

        control.set(tok)
        instruction.set(msg)

    =} 
    deadline(100 sec) {=
        print("\n=== DEADLINE TRIGGERED ===", flush=True)

        rd_val = self.s_val
        v_val  = self.v_val

        tok, msg = self.fallback_policy(rd_val, v_val)

        print(f"[FALLBACK RESULT] {tok} | {msg}", flush=True)

        control.set(tok)
        instruction.set(msg)
    =}
}

reactor Planner {
  input ctrl
  input instr
  input s
  input v
  output act
  output planned_instr

  state last_warn_ns = -1000000000000
  state last_printed = ""
  preamble{=
    import os
  =}

  initial mode monitoring {
    
    reaction(ctrl, instr, s, v) -> warning, actuate, planned_instr {=
      throttle = 1000000000
      kw  = (ctrl.value or "NONE").strip()
      instruction = (instr.value or "").strip()
      rd  = s.value if s.value is not None else 0.0
      v_val = v.value if v.value is not None else 0.0
      cmd = f'espeak "{instruction}" &'

      now_ns = lf.time.logical_elapsed()

      if kw == "ACTUATE" and rd > 0.0:
        if instruction and instruction != self.last_printed:
          log = f"[LOG] v={v_val:.2f} | s={rd:.2f} | {kw} | {instruction}"
          print(log, flush=True)
          planned_instr.set(log)
          if instruction:
            os.system(cmd)
          self.last_printed = instruction
        actuate.set()
        return

      if kw == "WARNING":
        if (now_ns - self.last_warn_ns) >= throttle:
          if instruction and instruction != self.last_printed:
            log = f"[LOG] v={v_val:.2f} | s={rd:.2f} | {kw} | {instruction}"
            print(log, flush=True)
            planned_instr.set(log)
            if instruction:
                os.system(cmd)
            self.last_printed = instruction
          self.last_warn_ns = now_ns
        warning.set()
        return
    =}
  }

  mode warning {
    reaction(ctrl, instr, s, v) -> monitoring, actuate, planned_instr {=
      throttle = 1000000000
      kw  = (ctrl.value or "NONE").strip()
      instruction = (instr.value or "").strip()
      rd  = s.value if s.value is not None else 0.0
      v_val = v.value if v.value is not None else 0.0
      cmd = f'espeak "{instruction}" &'

      now_ns = lf.time.logical_elapsed()

      if kw == "ACTUATE" and rd > 0.0:
        if instruction and instruction != self.last_printed:
          log = f"[LOG] v={v_val:.2f} | s={rd:.2f} | {kw} | {instruction}"
          print(log, flush=True)
          planned_instr.set(log)
          if instruction:
            os.system(cmd)
          self.last_printed = instruction
        actuate.set()
        return

      if kw == "NONE":
        monitoring.set()
        return

      if kw == "WARNING":
        if (now_ns - self.last_warn_ns) >= throttle:
          if instruction and instruction != self.last_printed:
            log = f"[LOG] v={v_val:.2f} | s={rd:.2f} | {kw} | {instruction}"
            print(log, flush=True)
            planned_instr.set(log)
            if instruction:
                os.system(cmd)
            self.last_printed = instruction
          self.last_warn_ns = now_ns
        return
    =}
  }

  mode actuate {
    reaction(ctrl, instr, s, v) -> act, monitoring, planned_instr {=
        kw = (ctrl.value or "NONE").strip()
        rd = s.value if s.value is not None else 0.0
        v_val = v.value if v.value is not None else 0.0
        instruction = (instr.value or "").strip()   

        cmd = f'espeak "{instruction}" &'

        if kw != "ACTUATE" or rd <= 0.0:
            monitoring.set()
            return

        log = f"[LOG] v={v_val:.2f} | s={rd:.2f} | {kw} | {instruction}"
        print(log, flush=True)

        i = f"[VERBAL] {kw} | Sent EmergencyBraking"
        act.set(11)
        planned_instr.set(log)

        if instruction:
            os.system(cmd)

        monitoring.set()
    =}
  }
}

reactor Coach{
    input s
    input v
    input st 
    input h

    

    output act
    output instr
    output ready

    llm = new LLMInference()
    a = new Planner()
    s -> llm.s
    v -> llm.v
    st -> llm.st
    h -> llm.h
   
    llm.control -> a.ctrl
    llm.instruction -> a.instr
    s -> a.s
    v -> a.v
    a.act -> act
    a.planned_instr -> instr

    llm.ready -> ready

    
}

federated reactor at 10.218.100.78 {
    d = new Driver()
    c = new Car()
    en = new Environment()
    adc = new Coach()

    adc.ready -> d.start_signal
    adc.ready -> c.start_signal
