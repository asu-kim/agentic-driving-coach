reactor Car{
    input start_signal
    state started = False

    input steer_in
    input accel_in
    input brake_in
    input actuate_in 
    input head_pos_in  
    input eye_pos_in

    state acceleration_net
    state velocity_init = 30
    state dist_init = 0.0
  
    state accel_val = 0.0
    state brake_val = 0.0
    state act_val 

    output velocity
    output steer
    output head_pos
    output eye_pos
    
    // d = new Driver()
    
    
    
    reaction(start_signal) {=
        self.started = True
    =}
    reaction(accel_in, brake_in, eye_pos_in, head_pos_in, steer_in, actuate_in)-> velocity, steer, head_pos, eye_pos {=
        if not self.started:
            return
        if d.accelerator.is_present:
            self.accel_val = float(d.accelerator.value)

        if d.brake.is_present:
            self.brake_val = float(d.brake.value)


        if actuate_in.is_present:
            self.act_val = actuate_in.value

        current_dri = lf.time.logical_elapsed()/1e6
        amsg = self.accel_val
        bmsg = self.brake_val
        act  = self.act_val
      

        def acel_cal(p):
            p = max(0.0, min(1.0, p))
            if p < 0.1:
                return p
            elif p < 0.6:
                return 2.4 * p
            else:
                return 4.0 * (p**2)

        def brake_cal(p):
            p = max(0.0, min(1.0, p))
            if p < 0.1:
                return -p
            elif p < 0.6:
                return -(5.4 * p)
            else:
                return -(9.0 * (p**2))

        # CLEAN INPUT
        if bmsg < 0.2:
            bmsg = 0.0
        if amsg < 0.05:
            amsg = 0.0

        vel_prev = self.velocity_init

        #ACTUATE 
        # if act == 11:
        #     target_speed = 11.0

        #     error = target_speed - vel_prev

        #     Kp = 1.2
        #     acc_net = Kp * error

        #     acc_net = max(-4.0, min(3.0, acc_net))


      
        # else:
        #     acc_net = 0.0

    
        #     if vel_prev < 9.5:
        #         acc_net = 1.5   

        #     elif amsg > 0.0:
        #         acc_net += acel_cal(amsg)

        #     elif bmsg > 0.0:
        #         acc_net += brake_cal(bmsg)

        acc_net = 0.0

        # --- DRIVER INPUT (always considered) ---
        if amsg > 0.0:
            acc_net += acel_cal(amsg)

        if bmsg > 0.0:
            acc_net += brake_cal(bmsg)

        # --- LLM ASSIST (only nudges, not overrides) ---
        if act == 11:
            target_speed = 11.0
            error = target_speed - vel_prev

            Kp = 1.0
            llm_acc = Kp * error

            # limit LLM influence so it doesn't dominate
            llm_acc = max(-2.0, min(2.0, llm_acc))

            acc_net += llm_acc

        # --- LOW SPEED AUTO BOOST (optional) ---
        if vel_prev < 9.5 and amsg == 0 and bmsg == 0:
            acc_net += 1.5
       
        vel = vel_prev + acc_net * 0.1
        vel = max(0.0, vel)
        dist = max(0.0, self.dist_init - vel * 0.1)
        self.velocity_init = vel
        self.dist_init = dist

        print(f"---------------------------------------------------------", flush=True)
        print(f"[CAR CLOCK] logical time: {current_dri:.2f}", flush=True)
        print(f"velocity={vel:.2f} acceleration={acc_net:.2f}", flush=True)
        print(f"acceleration={acc_net:.2f}", flush=True)

        velocity.set(vel)
        steer.set(d.steer.value)
        head_pos.set(d.head.value)
        eye_pos.set(d.eye.value)

    =}   
    

}



reactor Environment{
    input start_signal
    state started = False

    input v
    state pos_speed_change = 200.0
    state passed = False
    output displacement
    
    state v_val = 0.0

    reaction(start_signal) {=
        self.started = True
    =}
    reaction(v) -> displacement{=
        if not self.started:
            return
        if v.is_present:
            self.v_val = float(v.value)
        current_dri = lf.time.logical_elapsed()/1e6
        

        step = self.v_val * 0.1

        if not self.passed:
            self.pos_speed_change -= step

            if self.pos_speed_change <= 0.0:
                self.pos_speed_change = 0.0
                self.passed = True

            displacement.set(self.pos_speed_change)
        else:
            displacement.set(0.0)

        print(f"[ENV CLOCK] logical time: {current_dri:.2f} disp={self.pos_speed_change}", flush=True)
    =}
 
    
    
}



reactor LLMInference {
    input s
    input v
    input st 
    input h

    output ready
    output control
    output instruction

    state last_dl_tok = ""
    state last_dl_msg = ""
    state is_ready = False
    state s_val = 0.0
    state v_val = 0.0
    state st_val = 2
    state h_val = 5

    timer llmclock(0, 100 msec)

    preamble{=
        import ollama
        import time

        def run_llm_message(self, rd_val, v_val):
            import ollama
            import time
            # print(">>> ENTERING LLM CALL", flush=True)
            t0 = time.perf_counter()

            try:
                r = ollama.chat(
                    model="llama3:8b",
                    messages=[
                        {
                            "role": "system",
                            "content": (
                                        "You are a real-time driving coach.\n"

                                        "Output exactly ONE line in the format:\n"
                                        "TOKEN|Message\n"

                                        "TOKEN must be one of: NONE, WARNING, ACTUATE\n"

                                        "Variables:\n"
                                        "s = distance to speed change zone (meters)\n"
                                        "v = velocity (meter per second)\n"

                                        "Target speed is 11 meter per second.\n"

                                        "TOKEN RULES (strict):\n"
                                       
                                        "if s <= 80 and v > 13 → ACTUATE\n"
                                        "else if s <= 150 and v > 18 → WARNING\n"
                                        "else if s > 150 and v > 20 → WARNING\n"
                                        "else TOKEN=NONE\n"

                                        "MESSAGE RULES:\n"
                                        "- One short sentence (max 12 words)\n"
                                        "- Must include current values of s or v when useful\n"
                                        "- Must describe speed control action only\n"
                                        "- Use 'meter per second', not m/s\n"
                                        "- Be slightly varied and natural (avoid repeating same phrase)\n"

                                        "GUIDANCE STYLE:\n"
                                        "- If speed is high: suggest slowing down smoothly\n"
                                        "- If speed is low: suggest increasing gently\n"
                                        "- If near target: suggest maintaining steady speed\n"
                                        "- If close to zone: be more precise using distance\n"

                                        "SPECIAL CASE:\n"
                                        "If 10.5 <= v <= 11.5, say maintain steady speed.\n"

                                        "OUTPUT RULE:\n"
                                        "If TOKEN is NONE, output exactly: NONE|\n"
                                        "Do not add any extra text.\n"

                                        "EXAMPLES:\n"
                                        "ACTUATE| System takeover!!! Slow down from 18 meter per second to reach 11\n"
                                        "WARNING|At 55 meters, prepare to reduce speed from 16\n"
                                        "ACTUATE|Increase speed slightly from 9 meter per second\n"
                                        "NONE|"
                                    )
                        },
                        {
                            "role": "user",
                            "content": f"s={rd_val:.2f}, v={v_val:.2f}"
                        }
                    ],
                    options={"temperature": 0.0, "num_predict": 30},
                )
            except Exception as e:
                print(">>> LLM ERROR:", e, flush=True)
                return "NONE", "", 0.0

            ms = (time.perf_counter() - t0) * 1000.0
            raw = (r.get("message", {}).get("content", "") or "").strip()

            # print(f">>> RAW LLM OUTPUT: {raw}", flush=True)

            return "NONE", raw, ms

        def fallback_policy(self, rd_val, v_val):
            # print(f"[FALLBACK POLICY] evaluating s={rd_val:.2f}, v={v_val:.2f}", flush=True)

            if rd_val <= 0.0:
                return "NONE", ""

            if rd_val <= 25:
                return "ACTUATE", "Brake now."

            if rd_val >= 80:
                return "WARNING", "Speed limit ahead."

            return "NONE", ""

        def speak(self, msg):
            if not msg:
                return

        
            msg_lower = msg.lower()
            if "speed limit achieved" in msg_lower:
                msg = "Speed limit achieved. Maintain speed."

        
            msg = msg.replace("m/s", "meter per second")
            msg = msg.replace("mps", "meter per second")

            
            import re
            msg = re.sub(r"(\d+)\.(\d+)", r"\1", msg)

            print(f"[DEBUG SPEAK] {msg}", flush=True)

            try:
                if self.speech_proc is not None:
                    self.speech_proc.kill()
            except:
                pass

            self.speech_proc = subprocess.Popen(
                ["espeak", "-s", "120", msg],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
    =}

    reaction(startup) -> ready {=
        import time
        import ollama

        print("\n=== STARTUP ===", flush=True)
        print(f"[TIME] logical={lf.time.logical_elapsed()/1e6:.2f}", flush=True)
        print(f"[TIME] physical={lf.time.physical_elapsed()/1e6:.2f}", flush=True)

        try:
            r = ollama.chat(
                model="llama3:8b",
                messages=[
                    {
                        "role": "system",
                        "content": "You are a friendly driving coach."
                    },
                    {
                        "role": "user",
                        "content": "Output exactly: Hi. All the best."
                    }
                ],
                options={"temperature": 0.0, "num_predict": 10},
            )

            msg = (r.get("message", {}).get("content", "") or "").strip()

            if msg:
                print(f"[LLM GREETING] {msg}", flush=True)
                self.speak(msg)

                # wait until speech completes
                if self.speech_proc is not None:
                    self.speech_proc.wait()

        except Exception as e:
            print(">>> LLM ERROR:", e, flush=True)

            self.speak("Hi. All the best.")

            if self.speech_proc is not None:
                self.speech_proc.wait()

        # only after speech finishes
        self.is_ready = True
        ready.set(True)

        print("[STATUS] LLM READY", flush=True)
    =}

    reaction(s, v, st, h){=
        # print("\n=== INPUT REACTION TRIGGERED ===", flush=True)
        # print(f"[TIME] logical={lf.time.logical_elapsed()/1e6:.2f}", flush=True)
        # print(f"[TIME] physical={lf.time.physical_elapsed()/1e6:.2f}", flush=True)

        # print(f"[PRESENCE] s={s.is_present}, v={v.is_present}, st={st.is_present}, h={h.is_present}", flush=True)

        if s.is_present:
            self.s_val = s.value
        if v.is_present:
            self.v_val = v.value
        if st.is_present:
            self.st_val = st.value
        if h.is_present:
            self.h_val = h.value

        # print(f"[STATE UPDATE] s_val={self.s_val:.2f}, v_val={self.v_val:.2f}", flush=True)

    =}

    reaction(llmclock) -> control, instruction {=
        # print("\n=== LLM CLOCK TRIGGERED ===", flush=True)

        current_logical = lf.time.logical_elapsed()/1e6
        # print(f"[TIME] logical={current_logical:.2f}", flush=True)

        if not self.is_ready:
            # print("[SKIP] LLM not ready", flush=True)
            return

        rd_val = self.s_val
        v_val  = self.v_val

        # print(f"[STATE READ] s={rd_val:.2f}, v={v_val:.2f}", flush=True)

        if rd_val <= 0.0:
            rd_val = 0.0
            # control.set("NONE")
            # instruction.set("")
            # return

        # print("[LLM] calling model...", flush=True)

        tok_raw, msg_raw, ms = self.run_llm_message(rd_val, v_val)
        self.check_deadline()

        raw = (msg_raw or "").strip()

        if "|" in raw:
            tok, msg = raw.split("|", 1)
        else:
            tok = tok_raw or "NONE"
            msg = raw

        tok = tok.strip()
        msg = msg.strip()

        # print(f"[LLM RESULT] {tok} | {msg} | {ms:.2f} ms", flush=True)

        control.set(tok)
        instruction.set(msg)

    =} 
    deadline(100 sec) {=
        # print("\n=== DEADLINE TRIGGERED ===", flush=True)

        rd_val = self.s_val
        v_val  = self.v_val

        tok, msg = self.fallback_policy(rd_val, v_val)

        # print(f"[FALLBACK RESULT] {tok} | {msg}", flush=True)

        control.set(tok)
        instruction.set(msg)
    =}
}


reactor Planner {
  input ctrl
  input instr
  input s
  input v
  output act
  output planned_instr

  state last_warn_ns = -10000000000000
  state last_act_ns = -1000000000000
  state speech_proc 
  state reached = False
  state stable_count = 0

  preamble{=
    import subprocess

    def speak(self, msg):
        if not msg:
            return

        import re

        # Convert m/s to km/h
        def convert_mps_to_kmph(match):
            val = float(match.group(1))
            kmph = int(val * 3.6)
            return f"{kmph} kilometers per hour"

        # handle all formats
        msg = re.sub(r"(\d+\.?\d*)\s*m/s", convert_mps_to_kmph, msg)
        msg = re.sub(r"(\d+\.?\d*)\s*mps", convert_mps_to_kmph, msg)
        msg = re.sub(r"(\d+\.?\d*)\s*meter per second", convert_mps_to_kmph, msg)

        # Remove decimals for cleaner speech
        msg = re.sub(r"(\d+)\.(\d+)", r"\1", msg)

        print(f"[DEBUG SPEAK] {msg}", flush=True)

        # Wait for previous speech to finish
        if self.speech_proc is not None:
            self.speech_proc.wait()

        self.speech_proc = subprocess.Popen(
            ["espeak", "-s", "120", msg],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
  =}

  initial mode monitoring {
    
    reaction(ctrl, instr, s, v) -> warning, actuate, planned_instr {=
      kw  = (ctrl.value or "NONE").strip()
      instruction = (instr.value or "").strip()
      rd  = s.value if s.value is not None else 0.0
      v_val = v.value if v.value is not None else 0.0
      now_ns = lf.time.logical_elapsed()

      
      print(f"[DATA] v={v_val:.2f} | s={rd:.2f}", flush=True)

     
      if rd <= 1:
        target = 11.0
        error = abs(v_val - target)

        if error > 0.5:
          actuate.set()
          self.stable_count = 0
          return

        self.stable_count += 1

        if self.stable_count >= 5 and not self.reached:
          planned_instr.set(f"[FINAL] v={v_val:.2f}")
          self.speak("speed limit achieved but maintain speed")
          self.reached = True
          request_stop()

        return

      
      if kw == "ACTUATE" and rd > 0.0:
        actuate.set()

        if (now_ns - self.last_act_ns) >= 3000000000:
          if instruction:
            print(f"[LLM] ACTUATE | {instruction}", flush=True)
            planned_instr.set(instruction)
            self.speak(instruction)

          self.last_act_ns = now_ns
        return

      
      if kw == "WARNING":
        if (now_ns - self.last_warn_ns) >= 3000000000:
          if instruction:
            print(f"[LLM] WARNING | {instruction}", flush=True)
            planned_instr.set(instruction)
            self.speak(instruction)

          self.last_warn_ns = now_ns

        warning.set()
        return
    =}
  }

  mode warning {
    reaction(ctrl, instr, s, v) -> monitoring, actuate, planned_instr {=
      kw  = (ctrl.value or "NONE").strip()
      instruction = (instr.value or "").strip()
      rd  = s.value if s.value is not None else 0.0
      v_val = v.value if v.value is not None else 0.0

      
      print(f"[DATA] v={v_val:.2f} | s={rd:.2f}", flush=True)

      if rd <= 1:
        target = 11.0
        error = abs(v_val - target)

        if error > 0.5:
          actuate.set()
          self.stable_count = 0
          return

        self.stable_count += 1

        if self.stable_count >= 5 and not self.reached:
          self.speak("speed limit achieved but maintain speed")
          request_stop()

        return

      if kw == "ACTUATE" and rd > 0.0:
        actuate.set()
        return

      if kw == "NONE":
        monitoring.set()
        return
    =}
  }

  mode actuate {
    reaction(ctrl, instr, s, v) -> act, monitoring, planned_instr {=
      kw = (ctrl.value or "NONE").strip()
      rd = s.value if s.value is not None else 0.0
      v_val = v.value if v.value is not None else 0.0

     
      print(f"[DATA] v={v_val:.2f} | s={rd:.2f}", flush=True)

      if rd <= 1:
        target = 11.0
        error = abs(v_val - target)

        if error > 0.5:
          act.set(11)
          return

        self.speak("speed limit achieved but maintain speed")
        request_stop()
        return

      if kw != "ACTUATE":
        monitoring.set()
        return

      act.set(11)
      monitoring.set()
    =}
  }
}



reactor Coach{
    input s
    input v
    input st 
    input h

    

    output act
    output instr
    output ready

    llm = new LLMInference()
    a = new Planner()
    s -> llm.s
    v -> llm.v
    st -> llm.st
    h -> llm.h
   
    llm.control -> a.ctrl
    llm.instruction -> a.instr
    s -> a.s
    v -> a.v
    a.act -> act
    a.planned_instr -> instr

    llm.ready -> ready

    
}

federated reactor at 10.218.100.78 {
    d = new Driver()
    c = new Car()
    en = new Environment()
    adc = new Coach()
    // sim = new Simulation()

    // adc.ready -> d.start_signal
    adc.ready -> c.start_signal
    adc.ready -> en.start_signal
    // adc.ready -> sim.start_signal
  


    d.accelerator -> c.accel_in 
    d.brake -> c.brake_in 
    d.steer -> c.steer_in 
    d.head -> c.head_pos_in 
    d.eye -> c.eye_pos_in

    c.velocity -> en.v
    c.velocity -> adc.v
    c.steer -> adc.st
    c.head_pos -> adc.h
    // c.velocity -> sim.velocity_in
    // c.steer -> sim.steer_in

    en.displacement -> adc.s

    adc.act -> c.actuate_in after 200 ms
}