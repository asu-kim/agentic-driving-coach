target Python {files: ["face_detection.py"]}

preamble {=
    from face_detection import FaceDetector
=}

reactor FaceLandmark{
    input frame
    output head_msg
    output eye_msg

    state mesh
    state yaw_old

    reaction(startup) {=
        self.detector = FaceDetector()
    =}

    reaction(frame) -> head_msg, eye_msg {=
        img = frame.value

        if img is None:
            return

        out = self.detector.process(img)

        if out is None:
            return

        head_msg.set(out["head"])
        eye_msg.set(out["eye"])
    =}
}